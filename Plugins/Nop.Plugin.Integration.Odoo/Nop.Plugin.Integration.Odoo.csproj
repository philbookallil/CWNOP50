<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Copyright>Copyright © Cityweb</Copyright>
		<Company>CW Cityweb</Company>
		<Authors>CW Cityweb</Authors>
		<RepositoryType>Git</RepositoryType>
		<OutputPath>$(SolutionDir)\Presentation\Nop.Web\Plugins\Integration.Odoo</OutputPath>
		<OutDir>$(OutputPath)</OutDir>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<!-- Unit tests of internal helpers (sync tally, sync queue, Odoo JSON converters) — Tests/CW.Tests. -->
		<InternalsVisibleTo Include="CW.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="$(SolutionDir)\Presentation\Nop.Web\Nop.Web.csproj" />
		<!-- CW.Core by its built DLL, not a project reference (CLAUDE.md §10.2 Pattern C): build CW.Core first.
		     NopCommerce.sln records the build order as a solution dependency. -->
		<Reference Include="Nop.Plugin.CW.Core">
			<HintPath>..\..\Presentation\Nop.Web\Plugins\CW.Core\Nop.Plugin.CW.Core.dll</HintPath>
			<Private>false</Private>
			<ExcludeAssets>runtime</ExcludeAssets>
		</Reference>
		<ClearPluginAssemblies Include="$(SolutionDir)\Build\ClearPluginAssemblies.proj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="plugin.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="logo.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Views\OdooAdmin\Configure.cshtml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Views\OdooAdmin\SyncLogs.cshtml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Views\OdooAdmin\SyncLogView.cshtml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Views\_ViewImports.cshtml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Views\_ViewStart.cshtml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Content\Admin\Odoo\odoo-admin.js">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- This target execute after "Build" target -->
	<Target Name="NopTarget" AfterTargets="Build">
		<!-- Delete unnecessary libraries from plugins path -->
		<MSBuild Projects="@(ClearPluginAssemblies)" Properties="PluginPath=$(OutDir)" Targets="NopClear" />
	</Target>

</Project>
