@model PackNameCheckoutCompletedModel

@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts(T("PageTitle.Checkout").Text);
    NopHtml.AppendPageCssClassParts("html-checkout-page");
    NopHtml.AppendPageCssClassParts("html-order-completed-page");
    NopHtml.AddCssFileParts("~/Plugins/CW.Core/Content/PackName/checkout-completed.css");

    var settlement = Model.PackNameDetails.SettlementTotals;
}

<div class="page checkout-page order-completed-page packname-order-completed-page">
    <div class="page-title">
        <h1>@T("Checkout.ThankYou")</h1>
    </div>
    <div class="page-body checkout-data">
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.CheckoutCompletedTop, additionalData = Model.Completed })
        <div class="section order-completed">
            <h2 class="title">
                @T("Checkout.YourOrderHasBeenSuccessfullyProcessed")
            </h2>
            <div class="details">
                <div class="order-number">
                    <strong>@T("Checkout.OrderNumber"): @Model.Completed.CustomOrderNumber</strong>
                </div>
                <div class="details-link">
                    <a href="@Url.RouteUrl(NopRouteNames.Standard.ORDER_DETAILS, new { orderId = Model.Completed.OrderId })">@T("Checkout.PlacedOrderDetails")</a>
                </div>
            </div>
        </div>

        @await Component.InvokeAsync("PackNameOrderDetails", new { model = Model.PackNameDetails })

        @if (Model.PackNameDetails.HasSettlement)
        {
            <div class="section packname-completed-totals">
                <table class="cart-total">
                    <tbody>
                        <tr>
                            <td class="cart-total-left"><label>@T("Plugins.CW.Core.Order.SettleableTotal"):</label></td>
                            <td class="cart-total-right"><span>@settlement.GrossTotal</span></td>
                        </tr>
                        @if (settlement.HasSubsidy)
                        {
                            <tr>
                                <td class="cart-total-left"><label>@T("Plugins.CW.Core.Order.SubsidyUsed"):</label></td>
                                <td class="cart-total-right"><span>@settlement.SubsidyTotal</span></td>
                            </tr>
                        }
                        @if (settlement.HasCreditNotes)
                        {
                            <tr>
                                <td class="cart-total-left"><label>@T("Plugins.CW.Core.Order.CreditNotes"):</label></td>
                                <td class="cart-total-right"><span>@settlement.CreditNoteTotal</span></td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(Model.OrderTotalDiscount))
                        {
                            <tr>
                                <td class="cart-total-left"><label>@T("Plugins.CW.Core.Order.OrderDiscount"):</label></td>
                                <td class="cart-total-right"><span>@Model.OrderTotalDiscount</span></td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(Model.PaymentMethodAdditionalFee))
                        {
                            <tr>
                                <td class="cart-total-left"><label>@T("Order.PaymentMethodAdditionalFee"):</label></td>
                                <td class="cart-total-right"><span>@Model.PaymentMethodAdditionalFee</span></td>
                            </tr>
                        }
                        <tr class="order-total">
                            <td class="cart-total-left"><label><strong>@T("Plugins.CW.Core.Order.PayableBalance"):</strong></label></td>
                            <td class="cart-total-right"><span><strong class="cw-payable-balance">@settlement.PayableBalance</strong></span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }

        <div class="section order-completed-buttons">
            <div class="buttons">
                <button type="button" class="button-1 order-completed-continue-button" onclick="setLocation('@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)')">@T("Checkout.ThankYou.Continue")</button>
            </div>
        </div>
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.CheckoutCompletedBottom, additionalData = Model.Completed })
    </div>
</div>