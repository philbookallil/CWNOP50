@model PackNameOrderTotalsModel

<div class="total-info">
    <table class="cart-total">
        <tbody>
            <tr class="order-subtotal">
                <td class="cart-total-left">
                    <label>@T("ShoppingCart.Totals.SubTotal"):</label>
                </td>
                <td class="cart-total-right">
                    <span class="value-summary">@Model.SubTotal</span>
                </td>
            </tr>
            @if (!Model.ShowPayableBalance && !string.IsNullOrEmpty(Model.SubTotalDiscount))
            {
                <tr class="order-subtotal-discount">
                    <td class="cart-total-left">
                        <label>@T("ShoppingCart.Totals.SubTotalDiscount"):</label>
                    </td>
                    <td class="cart-total-right">
                        <span class="value-summary">@Model.SubTotalDiscount</span>
                    </td>
                </tr>
            }
            @if (!Model.HideShippingTotal)
            {
                <tr class="shipping-cost">
                    <td class="cart-total-left shipping-cost-total">
                        @if (Model.RequiresShipping && !string.IsNullOrEmpty(Model.Shipping))
                        {
                            <div class="shipping-arrow collapsed"></div>
                        }
                        <label>@T("ShoppingCart.Totals.Shipping"):</label>
                    </td>
                    <td class="cart-total-right">
                        @if (Model.RequiresShipping)
                        {
                            if (!string.IsNullOrEmpty(Model.Shipping))
                            {
                                <span class="value-summary">@Model.Shipping</span>
                            }
                            else
                            {
                                <span>@T("ShoppingCart.Totals.CalculatedDuringCheckout")</span>
                            }
                        }
                        else
                        {
                            <span>@T("ShoppingCart.Totals.Shipping.NotRequired")</span>
                        }
                    </td>
                </tr>
                @if (Model.RequiresShipping && !string.IsNullOrEmpty(Model.Shipping))
                {
                    @foreach (var shippingTotal in Model.ShippingTotals)
                    {
                        @if (!string.IsNullOrEmpty(Model.Shipping))
                        {
                            <tr class="shipping-cost shipping-cost-packname" style="display: none;">
                                <td class="cart-total-left">
                                    @if (!string.IsNullOrEmpty(shippingTotal.SelectedShippingMethod))
                                    {
                                        <label>@shippingTotal.EntityName:</label>
                                        <span class="selected-shipping-method">@T("ShoppingCart.Totals.Shipping.Method", shippingTotal.SelectedShippingMethod)</span>
                                    }
                                </td>
                                <td class="cart-total-right">
                                    <span class="value-summary">@shippingTotal.Shipping</span>
                                </td>
                            </tr>
                        }
                    }
                }
            }
            @if (!Model.ShowPayableBalance && !string.IsNullOrEmpty(Model.PaymentMethodAdditionalFee))
            {
                <tr class="additional-fees">
                    <td class="cart-total-left">
                        <label>@T("ShoppingCart.Totals.PaymentMethodAdditionalFee"):</label>
                    </td>
                    <td class="cart-total-right">
                        <span class="value-summary">@Model.PaymentMethodAdditionalFee</span>
                    </td>
                </tr>
            }
            @if (Model.DisplayTaxRates && Model.TaxRates.Count > 0)
            {
                foreach (var taxRate in Model.TaxRates)
                {
                    <tr class="tax-rate">
                        <td class="cart-total-left">
                            <label>@string.Format(T("ShoppingCart.Totals.TaxRateLine").Text, taxRate.Rate):</label>
                        </td>
                        <td class="cart-total-right">
                            <span>@taxRate.Value</span>
                        </td>
                    </tr>
                }
            }
            @if (Model.DisplayTax)
            {
                <tr class="tax-value">
                    <td class="cart-total-left">
                        <label>@T("ShoppingCart.Totals.Tax"):</label>
                    </td>
                    <td class="cart-total-right">
                        <span class="value-summary">@Model.Tax</span>
                    </td>
                </tr>
            }
            @if (Model.ShowPayableBalance)
            {
                <tr class="order-total">
                    <td class="cart-total-left">
                        <label>@(Model.HasSettlement ? T("Plugins.CW.Core.Subsidy.ShoppingCart.Totals.SettleableTotal") : T("ShoppingCart.Totals.OrderTotal")):</label>
                    </td>
                    <td class="cart-total-right">
                        @if (!string.IsNullOrEmpty(Model.OrderTotal))
                        {
                            <span class="value-summary"><strong>@Model.OrderTotal</strong></span>
                        }
                        else
                        {
                            <span>@T("ShoppingCart.Totals.CalculatedDuringCheckout")</span>
                        }
                    </td>
                </tr>
            }
            @if (!string.IsNullOrEmpty(Model.SubsidyTotal))
            {
                var showSubsidyDetails = !string.IsNullOrEmpty(Model.SubsidyForShipping);

                <tr class="order-subsidy">
                    <td class="cart-total-left subsidy-total">
                        @if (showSubsidyDetails)
                        {
                            <div class="subsidy-arrow collapsed"></div>
                        }
                        <label>@T("Plugins.CW.Core.Subsidy.ShoppingCart.Totals.Subsidy"):</label>
                    </td>
                    <td class="cart-total-right">
                        <span class="value-summary">@Model.SubsidyTotal</span>
                    </td>
                </tr>
                @if (showSubsidyDetails)
                {
                    <tr class="subsidy-detail" style="display: none;">
                        <td class="cart-total-left">
                            <label>@T("Plugins.CW.Core.Subsidy.ShoppingCart.Totals.SubsidyForStock"):</label>
                        </td>
                        <td class="cart-total-right">
                            <span class="value-summary">@Model.SubsidyForStock</span>
                        </td>
                    </tr>
                    <tr class="subsidy-detail" style="display: none;">
                        <td class="cart-total-left">
                            <label>@T("Plugins.CW.Core.Subsidy.ShoppingCart.Totals.SubsidyForShipping"):</label>
                        </td>
                        <td class="cart-total-right">
                            <span class="value-summary">@Model.SubsidyForShipping</span>
                        </td>
                    </tr>
                }
            }
            @if (!string.IsNullOrEmpty(Model.CreditNoteTotal))
            {
                <tr class="order-credit-note">
                    <td class="cart-total-left">
                        <label>@T("Plugins.CW.Core.ShoppingCart.Totals.CreditNotes"):</label>
                    </td>
                    <td class="cart-total-right">
                        <span class="value-summary">@Model.CreditNoteTotal</span>
                    </td>
                </tr>
            }
            @if (Model.ShowPayableBalance && !string.IsNullOrEmpty(Model.SubTotalDiscount))
            {
                <tr class="order-subtotal-discount">
                    <td class="cart-total-left">
                        <label>@(Model.HasSettlement ? T("Plugins.CW.Core.ShoppingCart.Totals.SubTotalDiscount") : T("ShoppingCart.Totals.SubTotalDiscount")):</label>
                    </td>
                    <td class="cart-total-right">
                        <span class="value-summary">@Model.SubTotalDiscount</span>
                    </td>
                </tr>
            }
            @if (Model.ShowPayableBalance && !string.IsNullOrEmpty(Model.PaymentMethodAdditionalFee))
            {
                <tr class="additional-fees">
                    <td class="cart-total-left">
                        <label>@T("ShoppingCart.Totals.PaymentMethodAdditionalFee"):</label>
                    </td>
                    <td class="cart-total-right">
                        <span class="value-summary">@Model.PaymentMethodAdditionalFee</span>
                    </td>
                </tr>
            }
            @if (!string.IsNullOrEmpty(Model.OrderTotalDiscount))
            {
                <tr class="discount-total">
                    <td class="cart-total-left">
                        <label>@(Model.HasSettlement ? T("Plugins.CW.Core.ShoppingCart.Totals.OrderTotalDiscount") : T("ShoppingCart.Totals.OrderTotalDiscount")):</label>
                    </td>
                    <td class="cart-total-right">
                        <span class="value-summary">@Model.OrderTotalDiscount</span>
                    </td>
                </tr>
            }
            @if (Model.GiftCards.Count > 0)
            {
                foreach (var gc in Model.GiftCards)
                {
                    <tr class="giftcard-summary">
                        <td class="cart-total-left">
                            <label>@T("ShoppingCart.Totals.GiftCardInfo"):</label>
                            <span>@T("ShoppingCart.Totals.GiftCardInfo.Code", gc.CouponCode)</span>
                            <span class="giftcard-remaining">@string.Format(T("ShoppingCart.Totals.GiftCardInfo.Remaining").Text, gc.Remaining)</span>
                        </td>
                        <td class="cart-total-right">
                            <span class="value-summary">@gc.Amount</span>
                        </td>
                    </tr>
                }
            }
            @if (Model.RedeemedRewardPoints > 0)
            {
                <tr class="reward-points">
                    <td class="cart-total-left">
                        <label>@string.Format(T("ShoppingCart.Totals.RewardPoints").Text, Model.RedeemedRewardPoints):</label>
                    </td>
                    <td class="cart-total-right">
                        <span class="value-summary">@Model.RedeemedRewardPointsAmount</span>
                    </td>
                </tr>
            }
            @if (!string.IsNullOrEmpty(Model.ExchangeFeesTotal))
            {
                var showFeeDetails = Model.ExchangeFeeDetails.Count > 1;

                <tr class="order-exchange-fees">
                    <td class="cart-total-left exchange-fees-total">
                        @if (showFeeDetails)
                        {
                            <div class="fee-arrow collapsed"></div>
                        }
                        <label>@T("Plugins.CW.Core.ShoppingCart.Totals.ExchangeFees"):</label>
                    </td>
                    <td class="cart-total-right">
                        <span class="value-summary">@Model.ExchangeFeesTotal</span>
                    </td>
                </tr>

                @if (showFeeDetails)
                {
                    foreach (var detail in Model.ExchangeFeeDetails)
                    {
                        <tr class="fee-detail" style="display: none;">
                            <td class="cart-total-left">
                                <label>@detail.Concept:</label>
                            </td>
                            <td class="cart-total-right">
                                <span class="value-summary">@detail.Amount</span>
                            </td>
                        </tr>
                    }
                }
            }
            @if (!Model.ShowPayableBalance)
            {
                <tr class="order-total">
                    <td class="cart-total-left">
                        <label>@T("ShoppingCart.Totals.OrderTotal"):</label>
                    </td>
                    <td class="cart-total-right">
                        @if (!string.IsNullOrEmpty(Model.OrderTotal))
                        {
                            <span class="value-summary"><strong>@Model.OrderTotal</strong></span>
                        }
                        else
                        {
                            <span>@T("ShoppingCart.Totals.CalculatedDuringCheckout")</span>
                        }
                    </td>
                </tr>
            }
            @if (Model.ShowPayableBalance)
            {
                <tr class="order-total">
                    <td class="cart-total-left">
                        <label>@T("Plugins.CW.Core.Subsidy.ShoppingCart.Totals.PayableBalance"):</label>
                    </td>
                    <td class="cart-total-right">
                        @if (!string.IsNullOrEmpty(Model.PayableBalance))
                        {
                            <span class="value-summary"><strong>@Model.PayableBalance</strong></span>
                        }
                        else
                        {
                            <span>@T("ShoppingCart.Totals.CalculatedDuringCheckout")</span>
                        }
                    </td>
                </tr>
            }
            @if (Model.WillEarnRewardPoints > 0)
            {
                <tr class="earn-reward-points">
                    <td class="cart-total-left">
                        <label>@T("ShoppingCart.Totals.RewardPoints.WillEarn"):</label>
                    </td>
                    <td class="cart-total-right">
                        <span class="value-summary">@string.Format(T("ShoppingCart.Totals.RewardPoints.WillEarn.Point").Text, Model.WillEarnRewardPoints)</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<script asp-location="Footer">
    $(document).ready(function () {
        $('.shipping-arrow').click(function () {
            if ($(this).hasClass('collapsed')) {
                $(this).addClass('expanded');
                $(this).removeClass('collapsed');
                $(".shipping-cost-packname").show();
            }
            else {
                $(this).addClass('collapsed');
                $(this).removeClass('expanded');
                $(".shipping-cost-packname").hide();
            }
        });

        $('.subsidy-arrow').click(function () {
            if ($(this).hasClass('collapsed')) {
                $(this).addClass('expanded');
                $(this).removeClass('collapsed');
                $(".subsidy-detail").show();
            }
            else {
                $(this).addClass('collapsed');
                $(this).removeClass('expanded');
                $(".subsidy-detail").hide();
            }
        });

        $('.fee-arrow').click(function () {
            if ($(this).hasClass('collapsed')) {
                $(this).addClass('expanded');
                $(this).removeClass('collapsed');
                $(".fee-detail").show();
            }
            else {
                $(this).addClass('collapsed');
                $(this).removeClass('expanded');
                $(".fee-detail").hide();
            }
        });
    });
</script>