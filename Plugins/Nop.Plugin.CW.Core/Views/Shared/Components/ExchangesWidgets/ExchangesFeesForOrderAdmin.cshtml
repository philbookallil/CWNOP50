@using Nop.Plugin.CW.Core.Domain.Exchanges;

@model ExchangesFeesModel

@if (Model.Fees.Count > 0)
{
    foreach (var feeDisplay in Model.Fees)
    {
        var namedFees = feeDisplay.FeeType == FeeType.AdditionalFee ? Model.AdditionalFees : null;
        var singleName = namedFees != null && namedFees.Count == 1 ? namedFees[0].FeeName : null;

        <div class="form-group row">
            <div class="col-md-3">
                <div class="label-wrapper cart-order-fee">
                    <label class="col-form-label">@feeDisplay.FeeConcept@(string.IsNullOrWhiteSpace(singleName) ? null : $" ({singleName})")</label>
                </div>
            </div>
            <div class="col-md-7">
                <div class="form-text-row">@feeDisplay.FeeAmountDisplay</div>
            </div>
        </div>

        if (namedFees != null && namedFees.Count > 1)
        {
            foreach (var fee in namedFees)
            {
                <div class="form-group row">
                    <div class="col-md-3">
                        <div class="label-wrapper">
                            <label class="col-form-label text-muted pl-4">@fee.FeeName</label>
                        </div>
                    </div>
                    <div class="col-md-7">
                        <div class="form-text-row text-muted">@fee.FeeAmountDisplay</div>
                    </div>
                </div>
            }
        }
    }
}