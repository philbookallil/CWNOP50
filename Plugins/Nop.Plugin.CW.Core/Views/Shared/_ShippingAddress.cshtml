@model AddressModel

<div class="section-address-title">
    @T("Plugins.CW.Core.PackNameCheckout.ShippingAddress")
</div>
<div class="address-item">
    <ul class="info">
        <li class="name">
            @Model.FirstName @Model.LastName
        </li>
        @if (Model.CompanyEnabled && !string.IsNullOrEmpty(Model.Company))
        {
            <li class="company">@Model.Company</li>
        }
        @if (Model.StreetAddressEnabled)
        {
            <li class="address1">
                @Model.Address1
            </li>
        }
        @if (Model.CityEnabled && !string.IsNullOrEmpty(Model.City) ||
        Model.CountyEnabled && !string.IsNullOrEmpty(Model.County) ||
        Model.StateProvinceEnabled && !string.IsNullOrEmpty(Model.StateProvinceName) ||
        Model.ZipPostalCodeEnabled && !string.IsNullOrEmpty(Model.ZipPostalCode))
        {
            var addressLine = string.Empty;
            if (Model.CityEnabled && !string.IsNullOrEmpty(Model.City))
            {
                addressLine += Model.City;
                if (Model.CountyEnabled && !string.IsNullOrEmpty(Model.County) ||
                Model.StateProvinceEnabled && !string.IsNullOrEmpty(Model.StateProvinceName) ||
                Model.ZipPostalCodeEnabled && !string.IsNullOrEmpty(Model.ZipPostalCode))
                {
                    addressLine += ", ";
                }
            }
            if (Model.CountyEnabled && !string.IsNullOrEmpty(Model.County))
            {
                addressLine += Model.County;
                if (Model.StateProvinceEnabled && !string.IsNullOrEmpty(Model.StateProvinceName) ||
                Model.ZipPostalCodeEnabled && !string.IsNullOrEmpty(Model.ZipPostalCode))
                {
                    addressLine += ", ";
                }
            }
            if (Model.StateProvinceEnabled && !string.IsNullOrEmpty(Model.StateProvinceName))
            {
                addressLine += Model.StateProvinceName;
                if (Model.ZipPostalCodeEnabled && !string.IsNullOrEmpty(Model.ZipPostalCode))
                {
                    addressLine += ", ";
                }
            }
            if (Model.ZipPostalCodeEnabled && !string.IsNullOrEmpty(Model.ZipPostalCode))
            {
                addressLine += Model.ZipPostalCode;
            }

            <li class="city-state-zip">
                @addressLine
            </li>
        }
        @if (Model.CountryEnabled && !string.IsNullOrEmpty(Model.CountryName))
        {
            <li class="country">
                @Model.CountryName
            </li>
        }
        <li class="email">
            <label>@T("Address.Fields.Email"):</label>
            @Model.Email
        </li>
        @if (Model.PhoneEnabled)
        {
            <li class="phone">
                @Model.PhoneNumber
            </li>
        }
        @if (Model.FaxEnabled)
        {
            <li class="fax">
                @Model.FaxNumber
            </li>
        }
        @if (!string.IsNullOrEmpty(Model.FormattedCustomAddressAttributes))
        {
            <li class="custom-attributes-view">
                @Html.Raw(Model.FormattedCustomAddressAttributes)
            </li>
        }
    </ul>
</div>