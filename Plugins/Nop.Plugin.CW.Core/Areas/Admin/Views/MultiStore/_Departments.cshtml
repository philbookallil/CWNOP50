@model DepartmentSearchModel

@{
    const string hideSearchBlockAttributeName = "MultiStoreDepartmentsPage.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);
}

<section id="departments-table-container">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-header d-flex align-items-center">
                        <span class="ms-card-title">
                            @T("Plugins.CW.Core.Admin.MultiStores.Departments")
                        </span>
                        <div class="ml-auto">
                            <button type="button"
                                    class="btn btn-primary btn-add-dep btn-sm">
                                <i class="fas fa-plus" aria-hidden="true"></i>
                                @T("Plugins.CW.Core.Admin.Departments.AddNew")
                            </button>
                        </div>
                    </div>
                    <div class="card card-default card-search">
                        <div class="card-body">
                            <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                                <div class="search-text">@T("Admin.Common.Search")</div>
                                <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                                <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                            </div>
                            <div class="search-body @(hideSearchBlock ? "closed" : "")">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="SearchDepartmentName" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="SearchDepartmentName" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="text-center col-12">
                                        <button type="button" id="search-departments" class="btn btn-primary btn-search"><i class="fas fa-search"></i>@T("Admin.Common.Search")</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card card-default">
                    <div class="card-body">
                        @{
                            var features = await cwFeatures.GetFeaturesAsync(Model.StoreId);
                            var departmentColumnCollection = new List<ColumnProperty>();

                            if (features.PackName)
                            {
                                departmentColumnCollection.Add(new ColumnProperty(nameof(DepartmentModel.Id))
                                {
                                    Render = new RenderChildCaret(),
                                    Width = "5",
                                    Searchable = false,
                                    ClassName = NopColumnClassDefaults.ChildControl
                                });
                            }

                            departmentColumnCollection.Add(new ColumnProperty(nameof(DepartmentModel.Name))
                            {
                                Title = T("Plugins.CW.Core.Admin.Departments.Department.Field.Name").Text,
                            });

                            departmentColumnCollection.Add(new ColumnProperty(nameof(DepartmentModel.Active))
                            {
                                Title = T("Plugins.CW.Core.Admin.Departments.Department.Field.Active").Text,
                                Width = "100",
                                ClassName = NopColumnClassDefaults.CenterAll,
                                Render = new RenderBoolean()
                            });

                            departmentColumnCollection.Add(new ColumnProperty(nameof(DepartmentModel.Id))
                            {
                                Title = T("Admin.Common.Edit").Text,
                                Width = "100",
                                ClassName = NopColumnClassDefaults.Button,
                                Render = new RenderCustom("Admin.StoreNav.render.tabEdit")
                            });

                            departmentColumnCollection.Add(new ColumnProperty(nameof(DepartmentModel.Id))
                            {
                                Title = T("Admin.Common.Delete").Text,
                                Width = "100",
                                ClassName =  NopColumnClassDefaults.Button,
                                Render = new RenderCustom("Admin.StoreNav.render.tabDelete")
                            });

                            DataTablesModel departmentsChildTable = null;

                            if (features.PackName)
                            {
                                var managerColumnCollection = new List<ColumnProperty>();
 
                                if (Model.MultiStoreSettingsModel.EmployeeNumberEnabled)
                                {
                                    managerColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.EmployeeNumber))
                                    {
                                        Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.EmployeeNumber").Text
                                    });
                                }

                                managerColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.Name))
                                {
                                    Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.Name").Text
                                });

                                if (Model.MultiStoreSettingsModel.PrintNameEnabled)
                                {
                                    managerColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.PrintName))
                                    {
                                        Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.PrintName").Text
                                    });
                                }

                                if (Model.MultiStoreSettingsModel.GenderEnabled)
                                {
                                    managerColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.Gender))
                                    {
                                        Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.Gender").Text,
                                        Width = "100",
                                        ClassName = NopColumnClassDefaults.CenterAll,
                                        Render = new RenderCustom("Admin.StoreNav.render.gender")
                                    });
                                }

                                if (Model.MultiStoreSettingsModel.POEntryEnabled)
                                {
                                    managerColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.POEntry))
                                    {
                                        Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.POEntry").Text
                                    });
                                }

                                managerColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.CustomerName))
                                {
                                    Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.Customer").Text
                                });

                                managerColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.Branch))
                                {
                                    Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.Branch").Text
                                });

                                managerColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.Group))
                                {
                                    Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.Group").Text,
                                    Width = "100",
                                    ClassName = NopColumnClassDefaults.CenterAll,
                                    Render = new RenderBoolean()
                                });

                                managerColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.Active))
                                {
                                    Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.Active").Text,
                                    Width = "100",
                                    ClassName = NopColumnClassDefaults.CenterAll,
                                    Render = new RenderBoolean()
                                });

                                managerColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.Id))
                                {
                                    Title = T("Admin.Common.Delete").Text,
                                    Width = "100",
                                    ClassName = NopColumnClassDefaults.Button,
                                    Render = new RenderCustom("Admin.StoreNav.render.departmentManagerDelete")
                                });

                                departmentsChildTable = new DataTablesModel
                                {
                                    Name = "departments-managers-grid",
                                    UrlRead = new DataUrl("DepartmentManagerList", "MultiStore", null),
                                    IsChildTable = true,
                                    Length = Model.PageSize,
                                    LengthMenu = Model.AvailablePageSizes,
                                    Filters = new List<FilterParameter>
                                    {
                                        new FilterParameter(nameof(DepartmentManagerSearchModel.DepartmentId), nameof(DepartmentModel.Id), true),
                                    },
                                    ColumnCollection = managerColumnCollection
                                };
                            }
                        }
                        @await Html.PartialAsync("Table", new DataTablesModel 
                        {
                            Name = "departments-grid",
                            UrlRead = new DataUrl("DepartmentList", "MultiStore", new RouteValueDictionary { [nameof(Model.StoreId)] = Model.StoreId }),
                            UrlDelete = new DataUrl("DeleteDepartment", "MultiStore", null),
                            SearchButtonId = "search-departments",
                            PrimaryKeyColumn = nameof(DepartmentModel.Id),
                            Length = Model.PageSize,
                            LengthMenu = Model.AvailablePageSizes,
                            Filters = new List<FilterParameter>
                            {
                                new FilterParameter(nameof(Model.SearchDepartmentName)),
                            },
                            ColumnCollection = departmentColumnCollection,
                            ChildTable = departmentsChildTable
                        })
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<div id="department-container" style="display: none;"></div>

@* EVERY RAZOR VALUE THIS TAB'S SCRIPT NEEDS ARRIVES THROUGH HERE.
   The script below is then plain JavaScript: no Model, no T(), no Url.Action inside a <script>,
   so nothing is HTML-encoded on its way into a string literal and the bundler can minify it. *@
<div class="dep-tab-config"
     data-store-id="@Model.StoreId"
     data-detail-url="@Url.Action("DepartmentDetail", "MultiStore")"
     data-delete-url="@Url.Action("DeleteDepartment", "MultiStore")"
     data-manager-delete-url="@Url.Action("DepartmentManagerDelete", "MultiStore")"
     style="display: none;"></div>

<script>
    (function () {
        var $panel = $('#tab-panel-departments');
        var $cfg = $panel.find('.dep-tab-config');

        var gridSel          = '#departments-grid';
        var storeId          = $cfg.data('storeId');
        var detailUrl        = $cfg.data('detailUrl');
        var deleteUrl        = $cfg.data('deleteUrl');
        var managerDeleteUrl = $cfg.data('managerDeleteUrl');

        //THE PANEL NODE OUTLIVES THE PARTIAL. loadPartial only swaps innerHTML, so without this
        //every delegated handler from the previous tab load is still attached and each click
        //fires one more time than the load before it.
        $panel.off('.deptab');
        $('#tab-departments').off('click.deptab');

        function refreshGrid() {
            updateTable(gridSel);
        }

        function showDepartmentList(show) {
            if (show) {
                $('#departments-table-container').show();
                $('#department-container').hide();
            } else {
                $('#departments-table-container').hide();
                $('#department-container').show();
            }
        }

        function loadDepartment(departmentId) {
            var $detail = $('#department-container');

            $detail.html('<div class="ms-loading-message">' + Admin.StoreNav.res('common.loading', 'Loading...') + '</div>');

            showDepartmentList(false);

            $.get(detailUrl, { storeId: storeId, departmentId: departmentId })
                .done(function (html) {
                    $detail.html(html);
                    bindDepartmentDetailEvents();
                })
                .fail(function (xhr) {
                    if (xhr.statusText === 'abort') return;
                    $detail.html('<div class="ms-error-message">' + Admin.StoreNav.res('common.failedToLoad', 'Failed to load.')
                        + ' <a href="javascript:void(0)" class="dep-retry">' + Admin.StoreNav.res('common.retry', 'Retry') + '</a></div>');
                });
        }

        function exitDepartmentDetails() {
            //THE TEARDOWN FOR THIS TAB'S DETAIL. Back, and anything else that closes the panel, comes
            //through here - so the unsaved-edit question is asked here rather than at each caller.
            if (!Admin.StoreNav.canLeaveForm()) return;

            Admin.StoreNav.navigate({ departmentId: null }, false);
            refreshGrid();
            showDepartmentList(true);
        }

        function bindDepartmentDetailEvents() {
            //WAS THIS A CREATE? Read it from the form BEFORE the post - the save reply carries no
            //reliable flag for it, and it is what decides whether the panel reloads for a new id.
            var wasNew = String($('#department-detail-form').find('[name="IsNew"]').val()).toLowerCase() === 'true';

            //Baseline for the unsaved-edit gate. The gate itself lives inside exitDepartmentDetails().
            //PARSE THE VALIDATION RULES. This form is injected by AJAX long after document.ready,
            //so unobtrusive never saw it and $form.valid() would answer true for a form with no
            //validator attached - nothing would be checked in the browser.
            $.validator.unobtrusive.parse($('#department-detail-form'));
            Admin.StoreNav.watchForm($('#department-detail-form'));
            Admin.StoreNav.consumeSavedFlash($('#department-detail-form'));

            // Back button
            $('#btn-department-back').on('click', function () {
                exitDepartmentDetails();
            });

            // Save department
            $('#btn-department-save').on('click', function () {
                var $btn = $(this);
                var $form = $('#department-detail-form');

                if (!$form.valid()) return;
                $btn.prop('disabled', true).text(Admin.StoreNav.res('common.saving', 'Saving...'));

                $.ajax({
                    type: 'POST',
                    url: $form.attr('action'),
                    data: $form.serialize(),
                    success: function (result, status, xhr) {
                        $btn.prop('disabled', false).text(Admin.StoreNav.res('common.save', 'Save'));
                        var ct = xhr.getResponseHeader('Content-Type') || '';
                        if (ct.indexOf('text/html') !== -1) {
                            // Validation failed — swap HTML and re-bind.
                            //NOTHING WAS WRITTEN, so the form stays dirty and takes no stamp.
                            $('#department-container').html(result);
                            bindDepartmentDetailEvents();
                            //AFTER THE RE-BIND, not before: binding the swapped-in form takes a fresh
                            //baseline from the posted values, which would read as clean. The rejected
                            //edits are real work, so the form must still ask before it is abandoned.
                            Admin.StoreNav.markFormDirty($('#department-detail-form'));
                            return;
                        }
                        //JSON REFUSAL. A {success:false} payload is not a saved record: reloading for
                        //its id would open a panel for something that was never written.
                        if (result && result.success === false) {
                            display_nop_error({ error: result.error || result.message || Admin.StoreNav.res('common.serverError', 'A server error occurred. Please try again.') });
                            return;
                        }

                        if (result) {
                            Admin.StoreNav.cacheName('dep', String(result.id), result.name);
                        }

                        //SAVE NEVER NAVIGATES. On an edit the panel already shows what was saved, so it
                        //stays and takes the stamp. On a create it reloads for the new id, which is what
                        //turns "save this first" into the working child grid - those grids are
                        //server-built DataTables with the id baked into UrlRead, so they cannot be
                        //unlocked client-side. The grid behind is refreshed by exitDepartmentDetails() on the way out.
                        Admin.StoreNav.watchForm($form);
                        if (wasNew && result) {
                            Admin.StoreNav.flashSavedAfterReload();
                            Admin.StoreNav.navigate({ departmentId: String(result.id) }, false);
                            loadDepartment(result.id);
                            return;
                        }
                        Admin.StoreNav.markSaved($form);
                    },
                    error: function () {
                        $btn.prop('disabled', false).text(Admin.StoreNav.res('common.save', 'Save'));
                        display_nop_error({ error: Admin.StoreNav.res('common.serverError', 'A server error occurred. Please try again.') });
                    }
                });
            });

            // Delete department
            $('#btn-department-delete').on('click', function () {
                var id = $(this).data('id');
                if (!confirm(Admin.StoreNav.res('departments.confirmDelete', 'Are you sure?'))) return;

                var postData = { id: id };
                addAntiForgeryToken(postData);

                $.post($(this).data('url'),
                    postData,
                    function (result) {
                        if (!result.success) {
                            display_nop_error({ error: result.error || Admin.StoreNav.res('common.couldNotDelete', 'Could not delete.') });
                            return;
                        }
                        //The record is gone, so there is nothing left to save and nothing to ask about.
                        Admin.StoreNav.releaseForm($('#department-detail-form'));
                        exitDepartmentDetails();
                    }
                );
            });
        }

        // ── Grid: retry link on a failed detail load ───────────────────────
        $panel.on('click.deptab', '.dep-retry', function () {
            location.reload();
        });

        // ── Grid: edit department → focus mode ─────────────────────────────
        //THE NAME COMES FROM THE GRID, NOT FROM THE MARKUP. The row is already in the DataTable,
        //so nothing has to be escaped into an attribute - which is exactly what the old
        //onclick="editDepartment(id, 'row.Name')" render was failing to do.
        $panel.on('click.deptab', '.btn-tab-edit', function () {
            var id = String($(this).data('id'));
            var row = $(gridSel).DataTable().row($(this).closest('tr')).data() || {};

            Admin.StoreNav.cacheName('dep', id, row.Name || '');
            Admin.StoreNav.navigate({ departmentId: id }, false);
            loadDepartment(id);
        });

        // ── Grid: delete department ────────────────────────────────────────
        $panel.on('click.deptab', '.btn-tab-delete', function () {
            var id = $(this).data('id');
            if (!confirm(Admin.StoreNav.res('departments.confirmDelete', 'Are you sure?'))) return;

            var postData = { id: id };
            addAntiForgeryToken(postData);

            $.post(deleteUrl, postData, function (result) {
                if (!result.success) {
                    display_nop_error({ error: result.error || Admin.StoreNav.res('common.couldNotDelete', 'Could not delete.') });
                    return;
                }
                refreshGrid();
            });
        });

        // ── Child grid: remove a manager from a department ─────────────────
        //THE CHILD ROW IS NOT IN THE PARENT DATATABLE, so unlike the two handlers above this one
        //cannot read its row through the parent's API. Both ids therefore travel on the button.
        $panel.on('click.deptab', '.btn-dep-manager-delete', function () {
            var managerId = $(this).data('id');
            var departmentId = $(this).data('departmentId');

            if (!confirm(Admin.StoreNav.res('common.areYouSure', 'Are you sure?'))) return;

            var postData = { id: managerId, departmentId: departmentId };
            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: 'POST',
                url: managerDeleteUrl,
                data: postData,
                success: function () {
                    refreshGrid();
                },
                error: function () {
                    display_nop_error({ error: Admin.StoreNav.res('common.couldNotDelete', 'Could not delete.') });
                }
            });
        });

        // ── Add department → focus mode ────────────────────────────────────
        $panel.on('click.deptab', '.btn-add-dep', function () {
            Admin.StoreNav.cacheName('dep', '0', Admin.StoreNav.res('new.department', 'New department'));
            Admin.StoreNav.navigate({ departmentId: 0 }, false);
            loadDepartment(0);
        });

        $('#tab-departments').on('click.deptab', function () {
            showDepartmentList(true);
        });

        var departmentId = Admin.StoreNav.getState().departmentId;
        if (departmentId) {
            loadDepartment(departmentId);
        }
    })();
</script>