                    </div>
                </div>
                <div id="pnlBulkOrderSettings">
                    <div class="form-group row">
                        <div class="col-md-3">
                            @*asp-parent-container, not asp-input: the axis slots are five selects with no single
                              bindable property, so the override checkbox has to target the container*@
                            <nop-override-store-checkbox asp-for="BulkOrderAxisAttributeIds_OverrideForStore" asp-parent-container="bulkorder-axis-slots" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                            <nop-label asp-for="BulkOrderAxisAttributeIds" />
                        </div>
                        <div class="col-md-9">
                            <div id="bulkorder-axis-slots">
                                @for (var i = 0; i < BulkOrderDefaults.MAX_AXIS_COUNT; i++)
                                {
                                    var selected = Model.BulkOrderAxisAttributeIds.Count > i ? Model.BulkOrderAxisAttributeIds[i] : 0;
                                    <div class="bulkorder-axis-slot">
                                        <label>@string.Format(T("Plugins.CW.Core.Admin.MultiStores.Settings.BulkOrderAxisSlot").Text, i + 1)</label>
                                        <select name="BulkOrderAxisAttributeIds[@i]" class="form-control">
                                            @foreach (var item in Model.AvailableProductAttributes)
                                            {
                                                <option value="@item.Value" selected="@(item.Value == selected.ToString())">@item.Text</option>
                                            }
                                        </select>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
