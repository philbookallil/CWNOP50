        <div class="float-right">
            <button type="button" class="btn btn-primary btn-save-settings">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
        </div>
    </div>

    <input asp-for="StoreId" type="hidden" />
    <div asp-validation-summary="All"></div>

    <nop-cards id="multistore-settings-cards">
