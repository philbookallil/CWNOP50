                            <nop-label asp-for="AllowHomeDelivery" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="AllowHomeDelivery" />
                            <span asp-validation-for="AllowHomeDelivery"></span>
                        </div>
                    </div>
                    <nop-nested-setting asp-for="AllowHomeDelivery" disable-auto-generation="true">
                        <div class="form-group row pnlAllowHomeDelivery">
                            <div class="col-md-3">
                                <nop-override-store-checkbox asp-for="AllowCustomersToAddAddress_OverrideForStore" asp-input="AllowCustomersToAddAddress" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="AllowCustomersToAddAddress" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="AllowCustomersToAddAddress" />
                                <span asp-validation-for="AllowCustomersToAddAddress"></span>
