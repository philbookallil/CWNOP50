@{
    //Every checkbox id the script tests, in one map, so applySettingVisibility() below
    //is plain JavaScript. Html.IdFor is the only thing that knows these ids for certain - the
    //script must not guess them from the property names.
    var settingIds = new Dictionary<string, string>
    {
        ["packNameEnable"]               = Html.IdFor(model => model.PackNameEnable).ToString(),
        ["subsidyEnable"]                = Html.IdFor(model => model.SubsidyEnable).ToString(),
        ["allowManagersToAddPackNames"]  = Html.IdFor(model => model.AllowManagersToAddPackNames).ToString(),
        ["useStaffAsPackName"]           = Html.IdFor(model => model.UseStaffAsPackName).ToString(),
        ["useBranchesAsPackNameList"]    = Html.IdFor(model => model.UseBranchesAsPackNameList).ToString(),
        ["printNameEnabled"]             = Html.IdFor(model => model.PrintNameEnabled).ToString(),
        ["allowHomeDelivery"]            = Html.IdFor(model => model.AllowHomeDelivery).ToString(),
        ["allowSubsidySelection"]        = Html.IdFor(model => model.AllowSubsidySelection).ToString(),
        ["allowToAddByExcel"]            = Html.IdFor(model => model.AllowToAddByExcel).ToString(),
        ["bulkOrderEnable"]              = Html.IdFor(model => model.BulkOrderEnable).ToString(),
        ["bulkOrderShowProductImages"]   = Html.IdFor(model => model.BulkOrderShowProductImages).ToString(),
        ["bulkOrderShowAttributeImages"] = Html.IdFor(model => model.BulkOrderShowAttributeImages).ToString()
    };
}

<div class="stset-config"
     data-ids='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(settingIds))'
     data-save-url="@Url.Action("StoreSettings", "MultiStore")"
     data-generate-packnames-url="@Url.Action("GeneratePackNames", "MultiStore")"
     data-generate-lists-url="@Url.Action("GeneratePackNameLists", "MultiStore")"
     style="display: none;"></div>

<script>
(function () {
    //ONE SCRIPT BLOCK, NO GLOBALS. This file carried three: two generate-button scripts buried in
    //the markup and this one. Six functions were global, and saveSettings() re-injects this whole
    //partial into #tab-panel-settings on a validation failure, which is why the handlers below are
    //delegated to that panel and torn down first - the panel node outlives the re-injection.
    var $panel = $('#tab-panel-settings').off('.stset');

    var $cfg = $panel.find('.stset-config');
    //jQuery parses the JSON in data-ids into an object, so this needs no JSON.parse.
    var ids                = $cfg.data('ids') || {};
    var saveUrl            = $cfg.data('saveUrl');
    var generatePackNames  = $cfg.data('generatePacknamesUrl');
    var generateListsUrl   = $cfg.data('generateListsUrl');

    var FORM = '#multistore-settings-form';

    function isChecked(key) {
        var $input = $('#' + ids[key]);

        //a checkbox absent from this screen counts as on, so a row is never
        //hidden merely because its governing control was not rendered
        return $input.length === 0 || $input.is(':checked');
    }

    function toggleRow(selector, visible) {
        if (visible)
            $(selector).showElement();
        else
            $(selector).hideElement();
    }

    function applySettingVisibility() {
        var packName = isChecked('packNameEnable');
        var subsidy  = packName && isChecked('subsidyEnable');
        var managers = packName && isChecked('allowManagersToAddPackNames');

        //whole PackNames card below the master switch
        toggleRow('#pnlPackNameSettings', packName);

        //single-parent rows inside the PackNames card
        toggleRow('.pnlUseStaffAsPackName',        packName && isChecked('useStaffAsPackName'));
        toggleRow('.pnlUseBranchesAsPackNameList', packName && isChecked('useBranchesAsPackNameList'));
        toggleRow('#pnlUseBranchesAsPackNameList', packName && isChecked('useBranchesAsPackNameList'));
        toggleRow('#pnlPrintNameEnabled',         packName && isChecked('printNameEnabled'));
        toggleRow('.pnlAllowManagersToAddPackNames', managers);
        toggleRow('.pnlAllowHomeDelivery',        packName && isChecked('allowHomeDelivery'));

        //multi-parent rows — the complete predicate lives here and nowhere else
        toggleRow('.pnlSubsidySelection',      managers && subsidy);
        toggleRow('.pnlAllowSubsidySelection', managers && subsidy && isChecked('allowSubsidySelection'));
        toggleRow('.pnlAllowToAddByExcel',     managers && subsidy && isChecked('allowSubsidySelection') && isChecked('allowToAddByExcel'));
        toggleRow('.pnlSubsidyOnly',           subsidy);

        //Subsidy card: subsidies are allocated per PackName, so the switch is
        //meaningless without PackNames
        toggleRow('#pnlSubsidyEnableRow', packName);

        //Registration card
        toggleRow('.pnlPackNameOnly', packName);

        //Bulk ordering card
        var bulkOrder = isChecked('bulkOrderEnable');
        toggleRow('#pnlBulkOrderSettings', bulkOrder);
        toggleRow('#pnlBulkOrderProductImageSize', bulkOrder && isChecked('bulkOrderShowProductImages'));
        toggleRow('#pnlBulkOrderAttributeImageSize', bulkOrder && isChecked('bulkOrderShowAttributeImages'));
    }

    //ONE GENERATOR FOR BOTH BUTTONS. The two markup scripts were the same twenty lines with three
    //resource keys and a URL swapped.
    function runGenerator(url, failedKey, queuedKey, errorKey, failedText, queuedText, errorText) {
        if (!confirm(Admin.StoreNav.res('common.areYouSure', 'Are you sure?'))) return;

        $.ajax({
            cache: false,
            type: 'POST',
            url: url,
            data: $(FORM).serialize(),
            success: function (data) {
                //The action answers NullJsonResult on success, which arrives as null -
                //so test `data &&` first; a bare !data.success throws here and breaks
                //the working path. On refusal it answers {success:false,message:...}
                //with the message already localised server-side.
                if (data && data.success === false) {
                    display_nop_error({ error: data.message || data.error || Admin.StoreNav.res(failedKey, failedText) });
                    return;
                }
                display_nop_error({ error: Admin.StoreNav.res(queuedKey, queuedText) });
            },
            error: function () {
                display_nop_error({ error: Admin.StoreNav.res(errorKey, errorText) });
            }
        });
    }

    function saveSettings() {
        $.ajax({
            cache: false,
            url: saveUrl,
            data: $(FORM).serialize(),
            type: 'POST',
            success: function (response) {
                if (response.success) {
                    //We reload the page to ensure all settings are correctly applied, especially those that might impact the UI like hiding/showing fields based on settings
                    location.reload();
                }
                else if (response.message) {
                    $('#tab-panel-settings').prepend('<div class="alert alert-danger">' + response.message + '</div>');
                }
                else {
                    $('#tab-panel-settings').html(response.settingssectionhtml);
                }
            }
        });
    }

    // ── Buttons, all delegated from the panel ──────────────────────────
    $panel.on('click.stset', '.btn-save-settings', function () {
        saveSettings();
        return false;
    });

    $panel.on('click.stset', '.generate-packnames', function () {
        runGenerator(generatePackNames,
            'generate.packNames.failed', 'generate.packNames.queued', 'generate.packNames.error',
            'Could not generate packaging names.',
            'Generating packaging names in the background',
            'Failed to generate packaging names');
        return false;
    });

    $panel.on('click.stset', '.generate-packnamelists', function () {
        runGenerator(generateListsUrl,
            'generate.lists.failed', 'generate.lists.queued', 'generate.lists.error',
            'Could not generate packaging name lists.',
            'Generating packaging name lists in the background',
            'Failed to generate packaging name lists');
        return false;
    });

    // ── Form wiring ────────────────────────────────────────────────────
    $('.multi-store-override-option').each(function (k, v) {
        checkOverriddenStoreValue(v, $(v).attr('data-for-input-selector'));
    });

    //Single source of truth for row visibility. Every conditional row carries exactly
    //one visibility class, and every class is set from exactly one line in
    //applySettingVisibility(). Never give a row two visibility classes:
    //showElement/hideElement are just removeClass/addClass('d-none'), so two
    //independent togglers fighting over one element is last-writer-wins.
    $panel.on('change.stset', FORM + ' input[type=checkbox]', applySettingVisibility);

    //UseStaffAsPackName forces UseBranchesAsPackNameList. That is a value rule,
    //not a visibility rule, so it stays separate from applySettingVisibility().
    $panel.on('change.stset', '#' + ids.useStaffAsPackName, function () {
        $('#' + ids.useBranchesAsPackNameList).prop('checked', $(this).is(':checked'));
    });

    applySettingVisibility();
})();
</script>