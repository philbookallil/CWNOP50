@model CostCenterSearchModel

@{
    const string hideSearchBlockAttributeName = "MultiStoreCostCentersPage.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);
}

<section id="costcenters-table-container" class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-header d-flex align-items-center">
                        <span class="ms-card-title">
                            @T("Plugins.CW.Core.Admin.MultiStores.CostCenters")
                        </span>
                        <div class="ml-auto">
                            <button type="button"
                                    class="btn btn-primary btn-add-cc btn-sm">
                                <i class="fas fa-plus" aria-hidden="true"></i>
                                @T("Plugins.CW.Core.Admin.CostCenters.AddNew")
                            </button>
                        </div>
                    </div>
                    <div class="card card-default card-search">
                        <div class="card-body">
                            <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                                <div class="search-text">@T("Admin.Common.Search")</div>
                                <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                                <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                            </div>
                            <div class="search-body @(hideSearchBlock ? "closed" : "")">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="SearchCostCenterName" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="SearchCostCenterName" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="SearchInBranches" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="SearchInBranches" />
                                            </div>
                                        </div>
                                        <div class="form-group row pnl-search-branch">
                                            <div class="col-md-4">
                                                <nop-label asp-for="SearchBranchName" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="SearchBranchName" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="text-center col-12">
                                        <button type="button" id="search-costcenters" class="btn btn-primary btn-search"><i class="fas fa-search"></i>@T("Admin.Common.Search")</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card card-default">
                    <div class="card-body">
                        @await Html.PartialAsync("Table", new DataTablesModel 
                        {
                            Name = "costcenters-grid",
                            UrlRead = new DataUrl("CostCenterList", "MultiStore", new RouteValueDictionary { [nameof(Model.StoreId)] = Model.StoreId }),
                            UrlDelete = new DataUrl("DeleteCostCenter", "MultiStore", null),
                            SearchButtonId = "search-costcenters",
                            Length = Model.PageSize,
                            LengthMenu = Model.AvailablePageSizes,
                            Filters = new List<FilterParameter>
                            {
                                new FilterParameter(nameof(Model.SearchCostCenterName)),
                                new FilterParameter(nameof(Model.SearchInBranches), typeof(bool)),
                                new FilterParameter(nameof(Model.SearchBranchName))
                            },
                            ColumnCollection = new List<ColumnProperty>
                            {
                                new ColumnProperty(nameof(CostCenterModel.Name))
                                {
                                    Title = T("Plugins.CW.Core.Admin.CostCenters.CostCenter.Field.Name").Text,
                                },
                                new ColumnProperty(nameof(CostCenterModel.Branch))
                                {
                                    Title = T("Plugins.CW.Core.Admin.CostCenters.CostCenter.Field.Branch").Text,
                                },
                                new ColumnProperty(nameof(CostCenterModel.Active))
                                {
                                    Title = T("Plugins.CW.Core.Admin.CostCenters.CostCenter.Field.Active").Text,
                                    Width = "100",
                                    ClassName = NopColumnClassDefaults.CenterAll,
                                    Render = new RenderBoolean()
                                },
                                new ColumnProperty(nameof(CostCenterModel.Id))
                                {
                                    Title = T("Admin.Common.Edit").Text,
                                    Width = "100",
                                    ClassName = NopColumnClassDefaults.Button,
                                    Render = new RenderCustom("Admin.StoreNav.render.tabEdit")
                                },
                                new ColumnProperty(nameof(CostCenterModel.Id))
                                {
                                    Title = T("Admin.Common.Delete").Text,
                                    Width = "100",
                                    ClassName =  NopColumnClassDefaults.Button,
                                    Render = new RenderCustom("Admin.StoreNav.render.tabDelete")
                                }
                            }
                        })
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<div id="costcenter-container" style="display: none;"></div>

<div class="cc-tab-config"
     data-store-id="@Model.StoreId"
     data-search-id="@Html.IdFor(model => model.SearchInBranches)"
     data-detail-url="@Url.Action("CostCenterDetail", "MultiStore")"
     data-delete-url="@Url.Action("DeleteCostCenter", "MultiStore")"
     style="display: none;"></div>

<script>
    (function () {
        var $panel = $('#tab-panel-costcenters');
        var $cfg = $panel.find('.cc-tab-config');

        var gridSel   = '#costcenters-grid';
        var storeId   = $cfg.data('storeId');
        var detailUrl = $cfg.data('detailUrl');
        var deleteUrl = $cfg.data('deleteUrl');
        var searchSel = '#' + $cfg.data('searchId');

        //THE PANEL NODE OUTLIVES THE PARTIAL. loadPartial only swaps innerHTML, so without this
        //every delegated handler from the previous tab load is still attached and each click
        //fires one more time than the load before it.
        $panel.off('.cctab');
        $('#tab-costcenters').off('click.cctab');

        // ── Search block ───────────────────────────────────────────────────
        function toggleSearchInBranches() {
            if ($(searchSel).is(':checked')) {
                $('.pnl-search-branch').showElement();
            } else {
                $('.pnl-search-branch').hideElement();
            }
        }

        $panel.on('click.cctab', searchSel, toggleSearchInBranches);
        toggleSearchInBranches();

        function refreshGrid() {
            updateTable(gridSel);
        }

        function showCostCenterList(show) {
            if (show) {
                $('#costcenters-table-container').show();
                $('#costcenter-container').hide();
            } else {
                $('#costcenters-table-container').hide();
                $('#costcenter-container').show();
            }
        }

        function loadCostCenter(costCenterId) {
            var $detail = $('#costcenter-container');

            $detail.html('<div class="ms-loading-message">' + Admin.StoreNav.res('common.loading', 'Loading...') + '</div>');

            showCostCenterList(false);

            $.get(detailUrl, { storeId: storeId, costCenterId: costCenterId })
                .done(function (html) {
                    $detail.html(html);
                    bindCostCenterDetailEvents();
                })
                .fail(function (xhr) {
                    if (xhr.statusText === 'abort') return;
                    $detail.html('<div class="ms-error-message">' + Admin.StoreNav.res('common.failedToLoad', 'Failed to load.')
                        + ' <a href="javascript:void(0)" class="cc-retry">' + Admin.StoreNav.res('common.retry', 'Retry') + '</a></div>');
                });
        }

        function exitCostCenterDetails() {
            //THE TEARDOWN FOR THIS TAB'S DETAIL. Back, and anything else that closes the panel, comes
            //through here - so the unsaved-edit question is asked here rather than at each caller.
            if (!Admin.StoreNav.canLeaveForm()) return;

            Admin.StoreNav.navigate({ costCenterId: null }, false);
            refreshGrid();
            showCostCenterList(true);
        }

        function bindCostCenterDetailEvents() {
            //WAS THIS A CREATE? Read it from the form BEFORE the post - the save reply carries no
            //reliable flag for it, and it is what decides whether the panel reloads for a new id.
            var wasNew = String($('#costcenter-detail-form').find('[name="IsNew"]').val()).toLowerCase() === 'true';

            //Baseline for the unsaved-edit gate. The gate itself lives inside exitCostCenterDetails().
            //PARSE THE VALIDATION RULES. This form is injected by AJAX long after document.ready,
            //so unobtrusive never saw it and $form.valid() would answer true for a form with no
            //validator attached - nothing would be checked in the browser.
            $.validator.unobtrusive.parse($('#costcenter-detail-form'));
            Admin.StoreNav.watchForm($('#costcenter-detail-form'));
            Admin.StoreNav.consumeSavedFlash($('#costcenter-detail-form'));

            // Back button
            $('#btn-costcenter-back').on('click', function () {
                exitCostCenterDetails();
            });

            // Save cost center
            $('#btn-costcenter-save').on('click', function () {
                var $btn = $(this);
                var $form = $('#costcenter-detail-form');

                if (!$form.valid()) return;
                $btn.prop('disabled', true).text(Admin.StoreNav.res('common.saving', 'Saving...'));

                $.ajax({
                    type: 'POST',
                    url: $form.attr('action'),
                    data: $form.serialize(),
                    success: function (result, status, xhr) {
                        $btn.prop('disabled', false).text(Admin.StoreNav.res('common.save', 'Save'));
                        var ct = xhr.getResponseHeader('Content-Type') || '';
                        if (ct.indexOf('text/html') !== -1) {
                            // Validation failed — swap HTML and re-bind.
                            //NOTHING WAS WRITTEN, so the form stays dirty and takes no stamp.
                            $('#costcenter-container').html(result);
                            bindCostCenterDetailEvents();
                            //AFTER THE RE-BIND, not before: binding the swapped-in form takes a fresh
                            //baseline from the posted values, which would read as clean. The rejected
                            //edits are real work, so the form must still ask before it is abandoned.
                            Admin.StoreNav.markFormDirty($('#costcenter-detail-form'));
                            return;
                        }
                        //JSON REFUSAL. A {success:false} payload is not a saved record: reloading for
                        //its id would open a panel for something that was never written.
                        if (result && result.success === false) {
                            display_nop_error({ error: result.error || result.message || Admin.StoreNav.res('common.serverError', 'A server error occurred. Please try again.') });
                            return;
                        }

                        if (result) {
                            Admin.StoreNav.cacheName('cc', String(result.id), result.name);
                        }

                        //SAVE NEVER NAVIGATES. On an edit the panel already shows what was saved, so it
                        //stays and takes the stamp. On a create it reloads for the new id, which is what
                        //turns "save this first" into the working child grid - those grids are
                        //server-built DataTables with the id baked into UrlRead, so they cannot be
                        //unlocked client-side. The grid behind is refreshed by exitCostCenterDetails() on the way out.
                        Admin.StoreNav.watchForm($form);
                        if (wasNew && result) {
                            Admin.StoreNav.flashSavedAfterReload();
                            Admin.StoreNav.navigate({ costCenterId: String(result.id) }, false);
                            loadCostCenter(result.id);
                            return;
                        }
                        Admin.StoreNav.markSaved($form);
                    },
                    error: function () {
                        $btn.prop('disabled', false).text(Admin.StoreNav.res('common.save', 'Save'));
                        display_nop_error({ error: Admin.StoreNav.res('common.serverError', 'A server error occurred. Please try again.') });
                    }
                });
            });

            // Delete cost center
            $('#btn-costcenter-delete').on('click', function () {
                var id = $(this).data('id');
                if (!confirm(Admin.StoreNav.res('costCenters.confirmDelete', 'Are you sure?'))) return;

                var postData = { id: id };
                addAntiForgeryToken(postData);

                $.post($(this).data('url'),
                    postData,
                    function (result) {
                        if (!result.success) {
                            display_nop_error({ error: result.error || Admin.StoreNav.res('common.couldNotDelete', 'Could not delete.') });
                            return;
                        }
                        //The record is gone, so there is nothing left to save and nothing to ask about.
                        Admin.StoreNav.releaseForm($('#costcenter-detail-form'));
                        exitCostCenterDetails();
                    }
                );
            });
        }

        // ── Grid: retry link on a failed detail load ───────────────────────
        $panel.on('click.cctab', '.cc-retry', function () {
            location.reload();
        });

        // ── Grid: edit cost center → focus mode ────────────────────────────
        //THE NAME COMES FROM THE GRID, NOT FROM THE MARKUP. The row is already in the DataTable,
        //so nothing has to be escaped into an attribute - which is exactly what the old
        //onclick="editCostCenter(id, 'row.Name')" render was failing to do.
        $panel.on('click.cctab', '.btn-tab-edit', function () {
            var id = String($(this).data('id'));
            var row = $(gridSel).DataTable().row($(this).closest('tr')).data() || {};

            Admin.StoreNav.cacheName('cc', id, row.Name || '');
            Admin.StoreNav.navigate({ costCenterId: id }, false);
            loadCostCenter(id);
        });

        // ── Grid: delete cost center ───────────────────────────────────────
        $panel.on('click.cctab', '.btn-tab-delete', function () {
            var id = $(this).data('id');
            if (!confirm(Admin.StoreNav.res('costCenters.confirmDelete', 'Are you sure?'))) return;

            var postData = { id: id };
            addAntiForgeryToken(postData);

            $.post(deleteUrl, postData, function (result) {
                if (!result.success) {
                    display_nop_error({ error: result.error || Admin.StoreNav.res('common.couldNotDelete', 'Could not delete.') });
                    return;
                }
                refreshGrid();
            });
        });

        // ── Add cost center → focus mode ───────────────────────────────────
        $panel.on('click.cctab', '.btn-add-cc', function () {
            Admin.StoreNav.cacheName('cc', '0', Admin.StoreNav.res('new.costCentre', 'New cost centre'));
            Admin.StoreNav.navigate({ costCenterId: 0 }, false);
            loadCostCenter(0);
        });

        $('#tab-costcenters').on('click.cctab', function () {
            showCostCenterList(true);
        });

        var costCenterId = Admin.StoreNav.getState().costCenterId;
        if (costCenterId) {
            loadCostCenter(costCenterId);
        }
    })();
</script>