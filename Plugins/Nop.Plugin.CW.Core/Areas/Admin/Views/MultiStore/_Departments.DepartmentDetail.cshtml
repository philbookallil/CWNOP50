@model DepartmentModel

<form id="department-detail-form" class="ms-detail-form"
        asp-controller="MultiStore"
        asp-action="SaveDepartment"
        method="post">

    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="StoreId" type="hidden" />
    <input asp-for="IsNew" type="hidden" />

    <div class="form-horizontal">
        <div class="card card-default bp-card card-ms-section">

            <div class="card-header d-flex align-items-center">
                <button type="button"
                        class="btn btn-sm btn-focus-back"
                        id="btn-department-back">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i>
                    @T("Plugins.CW.Core.Admin.Common.Back")
                </button>

                <span class="ms-card-title">
                    @if (Model.IsNew)
                    {
                        @T("Plugins.CW.Core.Admin.Departments.Department.New")
                    }
                    else
                    {
                        @Model.Name
                    }
                </span>
        
                <div class="ml-auto d-flex align-items-center" style="gap:6px">
                    @*SAVE NEVER NAVIGATES: the panel stays put, so this is the only
                      confirmation a save gets. Admin.StoreNav.markSaved() fills and shows it.*@
                    <span class="ms-saved-stamp" style="display:none"></span>
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            id="btn-department-save">
                        @T("Admin.Common.Save")
                    </button>
                    @if (!Model.IsNew)
                    {
                        <button type="button"
                                class="btn btn-danger btn-sm"
                                id="btn-department-delete"
                                data-id="@Model.Id"
                                data-url="/Admin/MultiStore/DeleteDepartment">
                            <i class="fas fa-trash" aria-hidden="true"></i>
                            @T("Admin.Common.Delete")
                        </button>
                    }
                </div>
            </div>

            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">

                        <div class="form-group row">
                            <div class="col-md-4">
                                <nop-label asp-for="Name" />
                            </div>
                            <div class="col-md-8">
                                <nop-editor asp-for="Name" asp-required="true"/>
                                <span asp-validation-for="Name"></span>
                            </div>
                        </div>


                    </div>
                    <div class="col-md-6">

                        <div class="form-group row">
                            <div class="col-md-4"><nop-label asp-for="Active" /></div>
                            <div class="col-md-8">
                                <nop-editor asp-for="Active" />
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
    @if ((await cwFeatures.GetFeaturesAsync(Model.StoreId)).PackName)
    {
        @await Html.PartialAsync("_Departments.DepartmentDetail.Managers", Model)
    }
</form>