<script>
    $(document).ready(function () {
        //See _StoreSettings.cshtml for the rationale: one element, one visibility class,
        //one line in applySettingVisibility() carrying the complete predicate.
        $('#cw-default-settings-form').on('change', 'input[type=checkbox]', applySettingVisibility);

        $('#@Html.IdFor(model => model.UseStaffAsPackName)').on('change', function () {
            $('#@Html.IdFor(model => model.UseBranchesAsPackNameList)')
                .prop('checked', $(this).is(':checked'));
        });

        applySettingVisibility();
    });

    function isChecked(id) {
        var $input = $('#' + id);

        return $input.length === 0 || $input.is(':checked');
    }

    function toggleRow(selector, visible) {
        if (visible)
            $(selector).showElement();
        else
            $(selector).hideElement();
    }

    function applySettingVisibility() {
        var packName = isChecked('@Html.IdFor(model => model.PackNameEnable)');
        var subsidy  = packName && isChecked('@Html.IdFor(model => model.SubsidyEnable)');
        var managers = packName && isChecked('@Html.IdFor(model => model.AllowManagersToAddPackNames)');

        toggleRow('#pnlPackNameSettings', packName);

        toggleRow('#pnlUseBranchesAsPackNameList', packName && isChecked('@Html.IdFor(model => model.UseBranchesAsPackNameList)'));
        toggleRow('#pnlPrintNameEnabled',         packName && isChecked('@Html.IdFor(model => model.PrintNameEnabled)'));
        toggleRow('.pnlAllowManagersToAddPackNames', managers);
        toggleRow('.pnlAllowHomeDelivery',        packName && isChecked('@Html.IdFor(model => model.AllowHomeDelivery)'));

        toggleRow('.pnlSubsidySelection',      managers && subsidy);
        toggleRow('.pnlAllowSubsidySelection', managers && subsidy && isChecked('@Html.IdFor(model => model.AllowSubsidySelection)'));
        toggleRow('.pnlAllowToAddByExcel',     managers && subsidy && isChecked('@Html.IdFor(model => model.AllowSubsidySelection)') && isChecked('@Html.IdFor(model => model.AllowToAddByExcel)'));
        toggleRow('.pnlSubsidyOnly',           subsidy);

        toggleRow('#pnlSubsidyEnableRow', packName);

        var bulkOrder = isChecked('@Html.IdFor(model => model.BulkOrderEnable)');
        toggleRow('#pnlBulkOrderSettings', bulkOrder);
        toggleRow('#pnlBulkOrderProductImageSize', bulkOrder && isChecked('@Html.IdFor(model => model.BulkOrderShowProductImages)'));
        toggleRow('#pnlBulkOrderAttributeImageSize', bulkOrder && isChecked('@Html.IdFor(model => model.BulkOrderShowAttributeImages)'));
    }
</script>