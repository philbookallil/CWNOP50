@model MultiStoreSettingsModel

@using Nop.Plugin.CW.Core.Domain.PackNames
@using Nop.Services;

@{
    //page title
    ViewBag.PageTitle = T("Plugins.CW.Core.Admin.MultiStores.Default.Settings").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName(CWCoreDefaults.DefaultStoreSettingsAdminMenuSystemName);

    var customer = await workContext.GetCurrentCustomerAsync();

    const string hidePackNameBlockAttributeName = "MultiStoreSettings.HidePackNameBlock";
    var hidePackNameBlock = await genericAttributeService.GetAttributeAsync<bool>(customer, hidePackNameBlockAttributeName);

    const string hideRegisterBlockAttributeName = "MultiStoreSettings.HideRegisterBlock";
    var hideRegisterBlock = await genericAttributeService.GetAttributeAsync<bool>(customer, hideRegisterBlockAttributeName);

    const string hideCreditNotesExchangesBlockAttributeName = "MultiStoreSettings.HideCreditNotesExchangesBlock";
    var hideCreditNotesExchangesBlock = await genericAttributeService.GetAttributeAsync<bool>(customer, hideCreditNotesExchangesBlockAttributeName);

    const string hideSubsidyBlockAttributeName = "MultiStoreSettings.HideSubsidyBlock";
    var hideSubsidyBlock = await genericAttributeService.GetAttributeAsync<bool>(customer, hideSubsidyBlockAttributeName);

    const string hideBulkOrderBlockAttributeName = "MultiStoreSettings.HideBulkOrderBlock";
    var hideBulkOrderBlock = await genericAttributeService.GetAttributeAsync<bool>(customer, hideBulkOrderBlockAttributeName);
}

<form id="cw-default-settings-form" asp-controller="MultiStore" asp-action="Settings" method="post">

