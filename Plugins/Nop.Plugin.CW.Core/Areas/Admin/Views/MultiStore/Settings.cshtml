                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-md-3">
                                        <nop-label asp-for="UseBranchesAsPackNameList" />
                                    </div>
                                    <div class="col-md-9">
                                        <nop-editor asp-for="UseBranchesAsPackNameList" />
                                        <span asp-validation-for="UseBranchesAsPackNameList"></span>
                                    </div>
                                </div>
                                <nop-nested-setting>
                                    <div class="form-group row" id="pnlUseBranchesAsPackNameList">
                                        <div class="col-md-3">
                                            <nop-label asp-for="PackNameListNameFrom" />
                                        </div>
                                        <div class="col-md-9">
                                            <nop-select asp-for="PackNameListNameFrom" asp-items="@await (((PackNameListNameFrom)Model.PackNameListNameFrom).ToSelectListAsync())" />
                                            <span asp-validation-for="PackNameListNameFrom"></span>
                                        </div>
                                    </div>
                                </nop-nested-setting>
                                <div class="form-group row">
                                    <div class="col-md-3">
                                        <nop-label asp-for="EmployeeNumberEnabled" />
                                    </div>
                                    <div class="col-md-9">
                                        <nop-editor asp-for="EmployeeNumberEnabled" />
                                        <span asp-validation-for="EmployeeNumberEnabled"></span>
                                    </div>
                                </div>
                                <div class="form-group row">
