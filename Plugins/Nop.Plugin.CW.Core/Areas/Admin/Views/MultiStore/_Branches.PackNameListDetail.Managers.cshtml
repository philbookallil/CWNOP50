@model PackNameListModel

<div class="card card-default bp-card card-ms-inner-section">
    <div class="card-header d-flex align-items-center">
        <span class="ms-card-title">
            @T("Plugins.CW.Core.Admin.PackNameLists.PackNameList.Managers")
        </span>
        @if (!Model.IsNew)
        {
            @* NO d-flex HERE. It is display:flex !important and outranks both an inline
               display:none and .d-none in this build's utility order, so .managers-table could
               never hide this wrapper - the Add manager button stayed visible with All managers
               on, where it does nothing. The wrapper holds one button, so flex bought nothing. *@
            <div class="ml-auto managers-table" style="gap:6px">
                <button type="submit" id="btnAddNewManager" class="btn btn-primary btn-sm" onclick="javascript:OpenWindow('@(Url.Action("ManagerAddPopup", "MultiStore", new {packNameListId = Model.Id, btnId = "btnRefreshManagers", formId = "pnlist-detail-form"}))', 800, 800, true); return false;">
                    @T("Plugins.CW.Core.Admin.PackNameLists.PackNameList.Managers.AddNew")
                </button>
            </div>
        }
    </div>
    <div class="card-body all-managers-selected-text">
        @T("Plugins.CW.Core.Admin.PackNameLists.PackNameList.Managers.AllManagersSelected")
    </div>
    @if (!Model.IsNew)
    {
        <div class="card-body managers-table">
            @{
                var gridModel = new DataTablesModel
                {
                    Name = "packnamelistmanagers-grid",
                    UrlRead = new DataUrl("ManagerList", "MultiStore", new RouteValueDictionary { [nameof(Model.ManagerSearchModel.PackNameListId)] = Model.ManagerSearchModel.PackNameListId }),
                    UrlDelete = new DataUrl("ManagerDelete", "MultiStore", new RouteValueDictionary { [nameof(Model.ManagerSearchModel.PackNameListId)] = Model.ManagerSearchModel.PackNameListId }),
                    Length = Model.ManagerSearchModel.PageSize,
                    LengthMenu = Model.ManagerSearchModel.AvailablePageSizes,
                    ColumnCollection = new List<ColumnProperty>()
                };

                if (Model.MultiStoreSettingsModel.EmployeeNumberEnabled)
                {
                    gridModel.ColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.EmployeeNumber))
                    {
                        Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.EmployeeNumber").Text
                    });
                }

                gridModel.ColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.Name))
                {
                    Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.Name").Text
                });

                if (Model.MultiStoreSettingsModel.PrintNameEnabled)
                {
                    gridModel.ColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.PrintName))
                    {
                        Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.PrintName").Text
                    });
                }

                if (Model.MultiStoreSettingsModel.GenderEnabled)
                {
                    gridModel.ColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.Gender))
                    {
                        Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.Gender").Text,
                        Width = "100",
                        ClassName = NopColumnClassDefaults.CenterAll,
                        Render = new RenderCustom("Admin.StoreNav.render.gender")
                    });
                }

                if (Model.MultiStoreSettingsModel.POEntryEnabled)
                {
                    gridModel.ColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.POEntry))
                    {
                        Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.POEntry").Text
                    });
                }

                gridModel.ColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.CustomerName))
                {
                    Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.Customer").Text
                });

                gridModel.ColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.Branch))
                {
                    Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.Branch").Text
                });

                gridModel.ColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.Group))
                {
                    Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.Group").Text,
                    Width = "100",
                    ClassName = NopColumnClassDefaults.CenterAll,
                    Render = new RenderBoolean()
                });

                gridModel.ColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.Active))
                {
                    Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.Active").Text,
                    Width = "100",
                    ClassName = NopColumnClassDefaults.CenterAll,
                    Render = new RenderBoolean()
                });

                gridModel.ColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.Id))
                {
                    Title = T("Admin.Common.Delete").Text,
                    Width = "100",
                    Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                    ClassName = NopColumnClassDefaults.Button
                });
            }

            @await Html.PartialAsync("Table", gridModel)
        </div>
        @* The id stays: ManagerAddPopup is handed it as btnId and clicks it on close.
           The behaviour moved to Admin.StoreNav's delegated .ms-grid-refresh handler. *@
        <button type="submit" id="btnRefreshManagers" class="ms-grid-refresh"
                data-grid="#packnamelistmanagers-grid" style="display: none"></button>
    }
    else
    {
        <div class="card-body managers-table">
            @T("Plugins.CW.Core.Admin.PackNameLists.PackNameList.Managers.SaveBeforeEdit")
        </div>
    }
</div>