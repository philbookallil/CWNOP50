@model DepartmentModel

<div class="card card-default bp-card card-ms-inner-section">
    <div class="card-header d-flex align-items-center">
        <span class="ms-card-title">
            @T("Plugins.CW.Core.Admin.Departments.Department.Managers")
        </span>
        @if (!Model.IsNew)
        {
            <div class="ml-auto d-flex align-items-center" style="gap:6px">
                <button type="submit" id="btnAddNewManager" class="btn btn-primary btn-sm" onclick="javascript:OpenWindow('@(Url.Action("DepartmentManagerAddPopup", "MultiStore", new {departmentId = Model.Id, btnId = "btnRefreshDepartmentManagers", formId = "department-detail-form"}))', 800, 800, true); return false;">
                    @T("Plugins.CW.Core.Admin.Departments.Department.Managers.AddNew")
                </button>
            </div>
        }
    </div>
    @if (!Model.IsNew)
    {
        <div class="card-body">
            @{
                var gridModel = new DataTablesModel
                {
                    Name = "departmentmanagers-grid",
                    UrlRead = new DataUrl("DepartmentManagerList", "MultiStore", new RouteValueDictionary { [nameof(Model.DepartmentManagerSearchModel.DepartmentId)] = Model.DepartmentManagerSearchModel.DepartmentId }),
                    UrlDelete = new DataUrl("DepartmentManagerDelete", "MultiStore", new RouteValueDictionary { [nameof(Model.DepartmentManagerSearchModel.DepartmentId)] = Model.DepartmentManagerSearchModel.DepartmentId }),
                    Length = Model.DepartmentManagerSearchModel.PageSize,
                    LengthMenu = Model.DepartmentManagerSearchModel.AvailablePageSizes,
                    ColumnCollection = new List<ColumnProperty>()
                };

                if (Model.DepartmentManagerSearchModel.MultiStoreSettingsModel.EmployeeNumberEnabled)
                {
                    gridModel.ColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.EmployeeNumber))
                    {
                        Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.EmployeeNumber").Text
                    });
                }

                gridModel.ColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.Name))
                {
                    Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.Name").Text
                });

                if (Model.DepartmentManagerSearchModel.MultiStoreSettingsModel.PrintNameEnabled)
                {
                    gridModel.ColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.PrintName))
                    {
                        Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.PrintName").Text
                    });
                }

                if (Model.DepartmentManagerSearchModel.MultiStoreSettingsModel.GenderEnabled)
                {
                    gridModel.ColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.Gender))
                    {
                        Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.Gender").Text,
                        Width = "100",
                        ClassName = NopColumnClassDefaults.CenterAll,
                        Render = new RenderCustom("Admin.StoreNav.render.gender")
                    });
                }

                if (Model.DepartmentManagerSearchModel.MultiStoreSettingsModel.POEntryEnabled)
                {
                    gridModel.ColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.POEntry))
                    {
                        Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.POEntry").Text
                    });
                }

                gridModel.ColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.CustomerName))
                {
                    Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.Customer").Text
                });

                gridModel.ColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.Branch))
                {
                    Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.Branch").Text
                });

                gridModel.ColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.Group))
                {
                    Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.Group").Text,
                    Width = "100",
                    ClassName = NopColumnClassDefaults.CenterAll,
                    Render = new RenderBoolean()
                });

                gridModel.ColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.Active))
                {
                    Title = T("Plugins.CW.Core.Admin.PackNames.PackName.Field.Active").Text,
                    Width = "100",
                    ClassName = NopColumnClassDefaults.CenterAll,
                    Render = new RenderBoolean()
                });

                gridModel.ColumnCollection.Add(new ColumnProperty(nameof(PackNameModel.Id))
                {
                    Title = T("Admin.Common.Delete").Text,
                    Width = "100",
                    Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                    ClassName = NopColumnClassDefaults.Button
                });
            }

            @await Html.PartialAsync("Table", gridModel)
        </div>
        @* The id stays: DepartmentManagerAddPopup is handed it as btnId and clicks it on close.
           The behaviour moved to Admin.StoreNav's delegated .ms-grid-refresh handler. *@
        <button type="submit" id="btnRefreshDepartmentManagers" class="ms-grid-refresh"
                data-grid="#departmentmanagers-grid" style="display: none"></button>
    }
    else
    {
        <div class="card-body">
            @T("Plugins.CW.Core.Admin.Departments.Department.Managers.SaveBeforeEdit")
        </div>
    }
</div>