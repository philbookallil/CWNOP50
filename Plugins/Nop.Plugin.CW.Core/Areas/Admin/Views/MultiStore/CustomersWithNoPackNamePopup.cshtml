@model PackNameSearchModel

@{
    Layout = "_AdminPopupLayout";

    //page title
    ViewBag.PageTitle = T("Plugins.CW.Core.Admin.PackNames.ShowCustomersWithoutPackName").Text;
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Plugins.CW.Core.Admin.PackNames.ShowCustomersWithoutPackName")
    </h1>
    <div class="float-right">
        &nbsp;
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="form-horizontal">
                <div class="cards-group">
                    <div class="card card-default card-search card-popup">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group row">
                                        <div class="col-sm-5">
                                            <nop-label asp-for="SearchPackName" />
                                        </div>
                                        <div class="col-sm-7">
                                            <nop-editor asp-for="SearchPackName" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group row">
                                        <div class="col-sm-5">
                                            <nop-label asp-for="SearchEmail" />
                                        </div>
                                        <div class="col-sm-7">
                                            <nop-editor asp-for="SearchEmail" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <button type="button" id="search-customers" class="btn btn-primary btn-search">
                                        <i class="fas fa-search"></i>
                                        @T("Admin.Common.Search")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card card-default">
                        <div class="card-body">
                            @await Html.PartialAsync("Table", new DataTablesModel
                            {
                                Name = "customers-grid",
                                UrlRead = new DataUrl("CustomersWithNoPackNamePopupList", "MultiStore", new RouteValueDictionary { [nameof(Model.StoreId)] = Model.StoreId }),
                                SearchButtonId = "search-customers",
                                Length = Model.PageSize,
                                LengthMenu = Model.AvailablePageSizes,
                                Filters = new List<FilterParameter>
                                {
                                    new FilterParameter(nameof(Model.SearchEmail)),
                                    new FilterParameter(nameof(Model.SearchPackName)),
                                },
                                ColumnCollection = new List<ColumnProperty>
                                {
                                    new ColumnProperty(nameof(ExtendedCustomerModel.Email))
                                    {
                                        Title = T("Admin.Customers.Customers.Fields.Email").Text,
                                        Render = new RenderCustom("renderColumnCustomer")
                                    },
                                    new ColumnProperty(nameof(ExtendedCustomerModel.FullName))
                                    {
                                        Title = T("Admin.Customers.Customers.Fields.FullName").Text
                                    },
                                    new ColumnProperty(nameof(ExtendedCustomerModel.Branch))
                                    {
                                        Title = T("Plugins.CW.Core.Admin.Customers.Customer.Fields.BranchId").Text
                                    },
                                    new ColumnProperty(nameof(ExtendedCustomerModel.Active))
                                    {
                                        Title = T("Admin.Customers.Customers.Fields.Active").Text,
                                        Width = "70",
                                        ClassName = NopColumnClassDefaults.CenterAll,
                                        Render = new RenderBoolean()
                                    }
                                }
                            })
                            <script>
                                function renderColumnCustomer(data, type, row, meta) {
                                    var link = '@Url.Content("~/Admin/ExtendedCustomer/Edit/")' + row.Id;
                                    return `<a href="#" onclick="redirectAndClose('${link}'); return false;">${data}</a>`;
                                }

                                function redirectAndClose(url) {
                                    window.opener.location.href = url;
                                    window.close();
                                }
                            </script>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>