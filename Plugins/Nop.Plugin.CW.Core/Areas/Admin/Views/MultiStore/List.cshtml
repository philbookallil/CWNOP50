@model MultiStoreSearchModel

@{
    //page title
    ViewBag.PageTitle = T("Plugins.CW.Core.Admin.MultiStores").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName(CWCoreDefaults.MultiStoreAdminMenuSystemName);
}

@{
    const string hideSearchBlockAttributeName = "MultiStoresPage.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Plugins.CW.Core.Admin.MultiStores")
    </h1>
    <div class="float-right">
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default card-search">
                    <div class="card-body">
                        <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                            <div class="search-text">@T("Admin.Common.Search")</div>
                            <div class="icon-search"><i class="fas fa-magnifying-glass" aria-hidden="true"></i></div>
                            <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                        </div>

                        <div class="search-body @(hideSearchBlock ? "closed" : "")">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchStore" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="SearchStore" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                </div>
                            </div>
                            <div class="row">
                                <div class="text-center col-12">
                                    <button type="button" id="search-stores" class="btn btn-primary btn-search">
                                        <i class="fas fa-magnifying-glass"></i>
                                        @T("Admin.Common.Search")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card card-default">
                    <div class="card-body">
                        @await Html.PartialAsync("Table", new DataTablesModel
                       {
                           Name = "stores-grid",
                           UrlRead = new DataUrl("StoreList", "MultiStore", null),
                           SearchButtonId = "search-stores",
                           Length = Model.PageSize,
                           LengthMenu = Model.AvailablePageSizes,
                           Filters = new List<FilterParameter>
                           {
                               new FilterParameter(nameof(Model.SearchStore)),
                           },
                           ColumnCollection = new List<ColumnProperty>
                            {
                                new ColumnProperty(nameof(MultiStoreModel.Name))
                                {
                                    Title = T("Admin.Configuration.Stores.Fields.Name").Text,
                                    Width = "100"
                                },
                                new ColumnProperty(nameof(MultiStoreModel.Url))
                                {
                                    Title = T("Admin.Configuration.Stores.Fields.Url").Text
                                },
                                new ColumnProperty(nameof(MultiStoreModel.DisplayOrder))
                                {
                                    Title = T("Admin.Configuration.Stores.Fields.DisplayOrder").Text,
                                    ClassName =  NopColumnClassDefaults.CenterAll
                                },
                                new ColumnProperty(nameof(MultiStoreModel.BranchesCount))
                                {
                                    Title = T("Plugins.CW.Core.Admin.MultiStores.Store.Fields.BranchesCount").Text,
                                    Width = "150",
                                    ClassName = NopColumnClassDefaults.CenterAll,
                                },
                                new ColumnProperty(nameof(MultiStoreModel.Id))
                                {
                                    Title = T("Plugins.CW.Core.Admin.MultiStores.Store.ManageStore").Text,
                                    Width = "100",
                                    ClassName =  NopColumnClassDefaults.Button,
                                    Render = new RenderCustom("renderManageStore")
                                }
                            }
                       })
                        <script>
                            function renderManageStore(data, type, row, meta) {
                                return '<div class="grid-actions">' +
                                    '<a href="@Url.Content("~/Admin/MultiStore/Edit/")' + data + '" class="btn btn-default "><i class="fa fa-cogs"></i>@T("Plugins.CW.Core.Admin.MultiStores.Store.ManageStore")</a>' +
                                    '</div>';
                            }
                        </script>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>