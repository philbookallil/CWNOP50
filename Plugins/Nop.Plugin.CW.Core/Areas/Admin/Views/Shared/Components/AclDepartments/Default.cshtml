@model AclDepartmentModel

@{
    var additionalCssClass = Model.IsAdvancedSetting ? "advanced-setting" : "";
}

<div class="form-group row @additionalCssClass">
    <div class="col-md-3">
        <nop-label asp-for="SelectedDepartmentIds" />
    </div>
    <div class="col-md-9">
        <div class="row">
            <div class="col-md-4">
                <nop-select asp-for="SelectedDepartmentIds" asp-items="Model.AvailableDepartments" asp-multiple="true" />
                <div id="acl-departments-config" data-none-available="@T("Plugins.CW.Core.Admin.AclDepartment.NoDepartmentsAvailable")" style="display: none;"></div>
                <script>
					$(function() {
						var departmentIdsInput = $('#@Html.IdFor(model => model.SelectedDepartmentIds)').select2({
                            closeOnSelect: false,
                            @if (!Model.AvailableDepartments.Any())
                            {
                                <text>
                                    disabled: true,
                                    placeholder: $('#acl-departments-config').data('noneAvailable'),
                                </text>
                            }
                        });
					});
                </script>
            </div>
            <div class="col-md-8">
                @await Component.InvokeAsync(typeof(AclDisabledWarningViewComponent))
            </div>
        </div>
    </div>
</div>