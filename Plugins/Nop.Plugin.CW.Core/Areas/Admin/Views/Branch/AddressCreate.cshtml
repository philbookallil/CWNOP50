@model CWAddressModel

@{
    //page title
    ViewBag.PageTitle = T("Plugins.CW.Core.Admin.Branches.Branch.Addresses.AddNew").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName(CWCoreDefaults.BranchAdminMenuSystemName);
}

<form asp-controller="Branch" asp-action="AddressCreate" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.CW.Core.Admin.Branches.Branch.Addresses.AddNew") 
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="Edit" asp-route-id="@Model.EntityId">@T("Plugins.CW.Core.Admin.Branches.Branch.Addresses.BackToBranch")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" class="btn btn-primary">
                @T("Admin.Common.Save")
            </button>
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/CW.Core/Areas/Admin/Views/Branch/_CreateOrUpdateAddress.cshtml", Model)
</form>