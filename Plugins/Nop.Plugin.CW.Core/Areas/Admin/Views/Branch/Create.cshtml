@model BranchModel

@{
    //page title
    ViewBag.PageTitle = T("Plugins.CW.Core.Admin.Branches.Branch.AddNew").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName(CWCoreDefaults.BranchAdminMenuSystemName);
}

<form asp-controller="Branch" asp-action="Create" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.CW.Core.Admin.Branches.Branch.AddNew")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="List">@T("Plugins.CW.Core.Admin.Branches.Branch.BackToList")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.SaveContinue")
            </button>
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/CW.Core/Areas/Admin/Views/Branch/_CreateOrUpdate.cshtml", Model)
</form>