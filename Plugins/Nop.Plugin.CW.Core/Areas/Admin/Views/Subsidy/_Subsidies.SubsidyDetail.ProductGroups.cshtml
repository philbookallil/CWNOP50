@model SubsidyModel

<div class="card card-default bp-card card-ms-inner-section">
    <div class="card-header d-flex align-items-center">
        <span class="ms-card-title">
            @T("Plugins.CW.Core.Admin.Subsidies.ProductGroups")
        </span>
        @if (!Model.IsNew)
        {
            <div class="ml-auto d-flex align-items-center" style="gap:6px">
                <button type="submit" class="btn btn-primary btn-sm" onclick="javascript:OpenWindow('@(Url.Action("SubsidyProductGroupPopup", "Subsidy", new {subsidyId = Model.Id, btnId = "btnRefreshSubsidyProductGroups", formId = "subsidy-detail-form"}))', 800, 800, true); return false;">
                    @T("Plugins.CW.Core.Admin.Subsidies.ProductGroups.AddNew")
                </button>
            </div>
        }
    </div>
    @if (!Model.IsNew)
    {
        <div class="card-body">
            @await Html.PartialAsync("Table", new DataTablesModel
            {
                Name = "subsidy-productgroups-grid",
                UrlRead = new DataUrl("SubsidyProductGroups", "Subsidy", new RouteValueDictionary { [nameof(Model.SubsidyProductGroupSearchModel.SubsidyId)] = Model.SubsidyProductGroupSearchModel.SubsidyId }),
                UrlUpdate = new DataUrl("SubsidyProductGroupUpdate", "Subsidy", null),
                UrlDelete = new DataUrl("SubsidyProductGroupDelete", "Subsidy", new RouteValueDictionary { [nameof(Model.SubsidyProductGroupSearchModel.SubsidyId)] = Model.SubsidyProductGroupSearchModel.SubsidyId }),
                Length = Model.SubsidyProductGroupSearchModel.PageSize,
                LengthMenu = Model.SubsidyProductGroupSearchModel.AvailablePageSizes,
                PrimaryKeyColumn = nameof(SubsidyProductGroupModel.Id),
                ColumnCollection = new List<ColumnProperty>
                {
                    new ColumnProperty(nameof(SubsidyProductGroupModel.Id))
                    {
                        Render = new RenderChildCaret(),
                        Width = "5",
                        Searchable = false,
                        ClassName = NopColumnClassDefaults.ChildControl
                    },
                    new ColumnProperty(nameof(SubsidyProductGroupModel.Icon))
                    {
                        Title = T("Plugins.CW.Core.Admin.ProductGroups.ProductGroup.Field.Icon").Text,
                        Width = "50",
                        ClassName = NopColumnClassDefaults.CenterAll,
                        Render = new RenderCustom("Admin.StoreNav.render.productGroupIcon")
                    },
                    new ColumnProperty(nameof(SubsidyProductGroupModel.Name))
                    {
                        Title = T("Plugins.CW.Core.Admin.ProductGroups.ProductGroup.Field.Name").Text
                    },
                    new ColumnProperty(nameof(SubsidyProductGroupModel.Description))
                    {
                        Title = T("Plugins.CW.Core.Admin.ProductGroups.ProductGroup.Field.Description").Text
                    },
                    new ColumnProperty(nameof(SubsidyProductGroupModel.DisplayOrder))
                    {
                        Title = T("Plugins.CW.Core.Admin.ProductGroups.ProductGroup.Field.DisplayOrder").Text,
                        Width = "100",
                        ClassName = NopColumnClassDefaults.CenterAll,
                        Editable = true,
                        EditType = EditType.Number
                    },
                    new ColumnProperty(nameof(SubsidyProductGroupModel.Quantity))
                    {
                        Title = T("Plugins.CW.Core.Admin.ProductGroups.ProductGroup.Field.Quantity").Text,
                        Width = "100",
                        ClassName = NopColumnClassDefaults.CenterAll,
                        Editable = true,
                        EditType = EditType.Number
                    },
                    new ColumnProperty(nameof(SubsidyProductGroupModel.Credit))
                    {
                        Title = T("Plugins.CW.Core.Admin.ProductGroups.ProductGroup.Field.Credit").Text,
                        Width = "100",
                        ClassName = NopColumnClassDefaults.CenterAll,
                        Editable = true,
                        EditType = EditType.Number
                    },
                    new ColumnProperty(nameof(SubsidyProductGroupModel.Id))
                    {
                        Title = T("Admin.Common.Edit").Text,
                        Width = "200",
                        ClassName =  NopColumnClassDefaults.Button,
                        Render = new RenderButtonsInlineEdit()
                    },
                    new ColumnProperty(nameof(SubsidyProductGroupModel.Id))
                    {
                        Title = T("Admin.Common.Delete").Text,
                        Width = "100",
                        Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                        ClassName = NopColumnClassDefaults.Button
                    }
                },
                ChildTable = new DataTablesModel
                {
                    Name = "subsidyproductgroups-products-grid",
                    UrlRead = new DataUrl("ProductGroupProducts", "Subsidy", null),
                    IsChildTable = true,
                    Length = Model.SubsidyProductGroupSearchModel.PageSize,
                    LengthMenu = Model.SubsidyProductGroupSearchModel.AvailablePageSizes,
                    Filters = new List<FilterParameter>
                    {
                        new FilterParameter(nameof(ProductGroupProductSearchModel.ProductGroupId), nameof(SubsidyProductGroupModel.ProductGroupId), true)
                    },
                    ColumnCollection = new List<ColumnProperty>
                    {
                        new ColumnProperty(nameof(ProductModel.PictureThumbnailUrl))
                        {
                            Title = T("Admin.Catalog.Products.Fields.PictureThumbnailUrl").Text,
                            Width = "100",
                            Render = new RenderPicture()
                        },
                        new ColumnProperty(nameof(ProductModel.Sku))
                        {
                            Title = T("Admin.Catalog.Products.Fields.Sku").Text,
                            Width = "100"
                        },
                        new ColumnProperty(nameof(ProductModel.Name))
                        {
                            Title = T("Admin.Catalog.Products.Fields.Name").Text
                        },
                        new ColumnProperty(nameof(ProductModel.ShortDescription))
                        {
                            Title = T("Admin.Catalog.Products.Fields.ShortDescription").Text
                        },
                        new ColumnProperty(nameof(ProductModel.Published))
                        {
                            Title = T("Admin.Catalog.Products.Fields.Published").Text,
                            Width = "80",
                            ClassName = NopColumnClassDefaults.CenterAll,
                            Render = new RenderBoolean()
                        },
                        new ColumnProperty(nameof(ProductModel.Id))
                        {
                            Title = T("Admin.Common.View").Text,
                            Width = "80",
                            ClassName =  NopColumnClassDefaults.Button,
                            Render = new RenderButtonView(new DataUrl("~/Admin/Product/Edit/"))
                        }
                    }
                }
            })
        </div>
        @* The id stays: SubsidyProductGroupPopup is handed it as btnId and clicks it on close.
           The behaviour moved to Admin.StoreNav's delegated .ms-grid-refresh handler. *@
        <button type="submit" id="btnRefreshSubsidyProductGroups" class="ms-grid-refresh"
                data-grid="#subsidy-productgroups-grid" style="display: none"></button>
    }
    else
    {
        <div class="card-body">
            @T("Plugins.CW.Core.Admin.Subsidies.ProductGroups.SaveBeforeEdit")
        </div>
    }
</div>