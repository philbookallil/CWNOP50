@model AddProductGroupToSubsidySearchModel

@{
    Layout = "_AdminPopupLayout";

    //page title
    ViewBag.PageTitle = T("Plugins.CW.Core.Admin.Subsidies.ProductGroups.AddNew").Text;
}

@if (ViewBag.RefreshPage == true)
{
    <script>
        try {window.opener.document.forms['@(Context.Request.Query["formId"])'].@(Context.Request.Query["btnId"]).click();}
        catch (e){}
        window.close();
    </script>
}
else
{
    <form asp-controller="Subsidy" asp-action="SubsidyProductGroupPopup"
          asp-route-subsidyId="@Context.Request.Query["subsidyId"]"
          asp-route-btnId="@Context.Request.Query["btnId"]"
          asp-route-formId="@Context.Request.Query["formId"]">
        <div class="content-header clearfix">
            <h1 class="float-left">
                @T("Plugins.CW.Core.Admin.Subsidies.ProductGroups.AddNew") - @Model.Subsidy
            </h1>
            <div class="float-right">
                &nbsp;
            </div>
        </div>
         <section class="content">
            <div class="container-fluid">
                <div class="form-horizontal">
                    <div class="cards-group">
                        <div class="card card-default card-search card-popup">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="SearchName" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="SearchName" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-12">
                                        <button type="button" id="search-subsidyproductgroups" class="btn btn-primary btn-search">
                                            <i class="fas fa-search"></i>
                                            @T("Admin.Common.Search")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card card-default">
                            <div class="card-body">
                                @await Html.PartialAsync("Table", new DataTablesModel
                                {
                                    Name = "subsidy-productgroups-grid",
                                    UrlRead = new DataUrl("SubsidyProductGroupPopupList", "Subsidy", new RouteValueDictionary { [nameof(Model.SubsidyId)] = Model.SubsidyId }),
                                    SearchButtonId = "search-subsidyproductgroups",
                                    Length = Model.PageSize,
                                    LengthMenu = Model.AvailablePageSizes,
                                    Filters = new List<FilterParameter>
                                    {
                                        new FilterParameter(nameof(Model.SearchName))
                                    },
                                    ColumnCollection = new List<ColumnProperty>
                                    {
                                        new ColumnProperty(nameof(ProductGroupModel.Id))
                                        {
                                            IsMasterCheckBox = true,
                                            Render = new RenderCheckBox(nameof(AddProductGroupToSubsidyModel.SelectedProductGroupIds)),
                                            ClassName = NopColumnClassDefaults.CenterAll,
                                            Width = "50"
                                        },
                                        new ColumnProperty(nameof(ProductGroupModel.Icon))
                                        {
                                            Title = T("Plugins.CW.Core.Admin.ProductGroups.ProductGroup.Field.Icon").Text,
                                            Width = "50",
                                            ClassName = NopColumnClassDefaults.CenterAll,
                                            Render = new RenderCustom("renderProductGroupIcon")
                                        },
                                        new ColumnProperty(nameof(ProductGroupModel.Name))
                                        {
                                            Title = T("Plugins.CW.Core.Admin.ProductGroups.ProductGroup.Field.Name").Text,
                                            Width = "150",
                                            ClassName = NopColumnClassDefaults.CenterAll,
                                        },
                                        new ColumnProperty(nameof(ProductGroupModel.Description))
                                        {
                                            Title = T("Plugins.CW.Core.Admin.ProductGroups.ProductGroup.Field.Description").Text,
                                            Width = "350",
                                            ClassName = NopColumnClassDefaults.CenterAll,
                                        },
                                        new ColumnProperty(nameof(ProductGroupModel.DisplayOrder))
                                        {
                                            Title = T("Plugins.CW.Core.Admin.ProductGroups.ProductGroup.Field.DisplayOrder").Text,
                                            Width = "100",
                                            ClassName = NopColumnClassDefaults.CenterAll,
                                        },
                                        new ColumnProperty(nameof(ProductGroupModel.ProductCount))
                                        {
                                            Title = T("Plugins.CW.Core.Admin.ProductGroups.ProductGroup.Field.ProductCount").Text,
                                            Width = "100",
                                            ClassName = NopColumnClassDefaults.CenterAll,
                                        },
                                        new ColumnProperty(nameof(ProductGroupModel.Active))
                                        {
                                            Title = T("Plugins.CW.Core.Admin.ProductGroups.ProductGroup.Field.Active").Text,
                                            Width = "100",
                                            ClassName = NopColumnClassDefaults.CenterAll,
                                            Render = new RenderBoolean()
                                        },
                                    }
                                })
                            </div>
                            <div class="card-footer">
                                <button type="submit" name="save" class="btn btn-primary">
                                    <i class="far fa-save"></i>
                                    @T("Admin.Common.Save")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </form>
    <script>
        function renderProductGroupIcon(data, type, row) {
            return data ? '<svg class="pg-icon" style="color:' + (row.Colour ? row.Colour : "#000000") + '" aria-hidden="true">' + '<use href="/Plugins/CW.Core/Content/icons/pg-icons.svg#' + data + '"/></svg>' : '';
        }
    </script>
}