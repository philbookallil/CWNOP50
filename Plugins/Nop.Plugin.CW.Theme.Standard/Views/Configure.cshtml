@model StandardThemeSettingsModel
@{
    Layout = "_ConfigurePlugin";
}

<form asp-controller="StandardThemeAdmin" asp-action="Configure" method="post">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-header">
                @T("Plugins.CW.Theme.Standard.Configure.Title")
            </div>
            <div class="card-body">
                @await Component.InvokeAsync("StoreScopeConfiguration")

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="LightNavBar_OverrideForStore" asp-input="LightNavBar" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="LightNavBar" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="LightNavBar" />
                        <span asp-validation-for="LightNavBar"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="SquareCorners_OverrideForStore" asp-input="SquareCorners" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="SquareCorners" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="SquareCorners" />
                        <span asp-validation-for="SquareCorners"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card card-default">
            <div class="card-body">
                <button type="submit" name="save" class="btn btn-primary">
                    <i class="far fa-save"></i>
                    @T("Admin.Common.Save")
                </button>
            </div>
        </div>
    </div>
</form>
