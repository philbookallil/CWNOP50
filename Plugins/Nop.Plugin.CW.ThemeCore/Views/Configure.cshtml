        // The signed preview token is appended when a view loads. It expires (server-side lifetime), and an admin can
        // keep this page open for hours, so past the refresh point a fresh one is fetched before the next load.
        var previewStoreId = $cfg.data('previewStoreId');
        var previewToken = String($cfg.data('previewToken') || '');
