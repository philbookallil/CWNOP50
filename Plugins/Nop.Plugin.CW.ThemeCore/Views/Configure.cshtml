<div id="cw-themecore-config"
     data-generate-url="@Url.Action("GenerateBrand", "CwThemeCore")"
     data-random-url="@Url.Action("RandomBrand", "CwThemeCore")"
     data-refresh-token-url="@Url.Action("RefreshPreviewToken", "CwThemeCore")"
     data-live-enabled="@(Model.LivePreviewEnabled ? "true" : "false")"
     data-preview-store-id="@Model.PreviewStoreId"
     data-preview-store-origin="@Model.PreviewStoreOrigin"
     data-preview-urls="@JsonSerializer.Serialize(Model.PreviewUrls)"
     data-preview-layout-classes="@JsonSerializer.Serialize(Model.PreviewLayoutClasses)"
     data-preview-token="@Model.PreviewToken"
     data-preview-token-key="@Nop.Plugin.CW.ThemeCore.Infrastructure.CwPreviewFramingMiddleware.QueryKey"
     data-preview-token-refresh-after="@Model.PreviewTokenRefreshAfterSeconds"
     data-preview-primary-logo="@Model.PreviewPrimaryLogoUrl"
     data-preview-second-logo="@Model.PreviewSecondLogoUrl"
     data-preview-reverse-logos="@(Model.ReverseLogos ? "true" : "false")"
     style="display: none;"></div>

<script asp-location="Footer">
    $(function () {
        var $cfg = $('#cw-themecore-config');
        var generateUrl = $cfg.data('generateUrl');
        var randomUrl = $cfg.data('randomUrl');

        var map = {
            'PrimaryColor': '--cw-primary',
            'PrimaryTintColor': '--cw-primary-tint',
            'SuccessColor': '--cw-success',
            'DangerColor': '--cw-danger',
            'WarningColor': '--cw-warning',
            'DarkColor': '--cw-dark'
        };
        var preview = document.getElementById('cw-theme-preview');
        var hexRe = /^([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/;
        var radiusInput = document.getElementById('ButtonRadius');
        var radiusRange = document.getElementById('ButtonRadius_range');

        function normalize(v) { return (v || '').trim().replace(/^#/, ''); }

        function currentRadius() {
            var n = parseInt(radiusInput && radiusInput.value, 10);
            if (isNaN(n) || n < 0) n = 0;
            if (n > 999) n = 999;
            return n;
        }
        function applyRadiusToPreview() {
            var n = currentRadius();
            preview.style.setProperty('--cw-btn-radius', n + 'px');
            if (radiusRange) radiusRange.value = Math.min(n, parseInt(radiusRange.max, 10) || 24);
        }

        function updateSwatches() {
            document.querySelectorAll('#cw-brand-swatches .cw-sw').forEach(function (sw) {
                var input = document.getElementById(sw.getAttribute('data-field'));
                var dot = sw.querySelector('.cw-sw-dot');
                if (!input || !dot) return;
                var v = normalize(input.value);
                if (/^[0-9a-fA-F]{3,8}$/.test(v)) { dot.style.background = '#' + v; }
            });
        }

        function refresh() {
            Object.keys(map).forEach(function (id) {
                var input = document.getElementById(id);
                if (!input) return;
                var val = normalize(input.value);
                if (hexRe.test(val)) {
                    preview.style.setProperty(map[id], '#' + val);
