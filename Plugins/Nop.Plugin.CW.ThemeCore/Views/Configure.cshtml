            if (!r) return;
            var pw = popover.offsetWidth, ph = popover.offsetHeight;
            var left = Math.min(r.left, window.innerWidth - pw - 8);
            if (left < 8) left = 8;
            var top = r.bottom + 8;
            if (top + ph > window.innerHeight - 8) top = r.top - ph - 8; // flip above if no room below
            if (top < 8) top = 8;
