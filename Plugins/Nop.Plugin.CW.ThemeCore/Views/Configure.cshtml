        }

        function buildPopover(region) {
            popoverSync = [];
            var cfg = regionConfig[region];
            popover = document.createElement('div'); popover.className = 'cw-style-popover';
            var close = document.createElement('button'); close.type = 'button'; close.className = 'cw-pop-close'; close.innerHTML = '&times;';
            close.addEventListener('click', closePopover); popover.appendChild(close);
            var h = document.createElement('h4'); h.textContent = cfg.label; popover.appendChild(h);
            cfg.controls.forEach(function (c) { popover.appendChild(c.kind === 'radius' ? buildRadiusRow(c) : buildColorRow(c)); });
            var aiLabel = document.createElement('div'); aiLabel.className = 'cw-pop-ai-label'; aiLabel.textContent = 'Or ask AI to tweak this:';
