        var previewTokenIssuedAt = Date.now();
        var refreshTokenUrl = $cfg.data('refreshTokenUrl');

        // Preview header logos (mirror the live store): primary = core store logo, second = CW co-brand logo.
        var previewPrimaryLogo = $cfg.data('previewPrimaryLogo') || '';
