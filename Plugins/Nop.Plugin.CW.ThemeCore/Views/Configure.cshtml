        $('#cw-brand-prompt').on('keydown', function (e) {
            if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); $('#cw-brand-generate').click(); }
        });

        // button-radius: slider <-> number field, both drive the preview live
