@model CwThemeSettingsModel
@using System.Text.Json
@{
    Layout = "_ConfigurePlugin";
}
@functions {
    // Mini page-diagram for a layout picker card, chosen by the manifest's wireframe token (neutral admin SVG).
    static string LayoutWireframe(string token)
    {
        const string open = "<svg viewBox='0 0 120 84' class='cw-wf-svg' aria-hidden='true'><rect class='wf-page' x='1' y='1' width='118' height='82' rx='5'/>";
        const string close = "</svg>";
        var inner = token switch
        {
            "boxed" =>
                "<rect class='wf-bar' x='24' y='8' width='72' height='12' rx='2'/>" +
                "<rect class='wf-block' x='24' y='26' width='72' height='20' rx='2'/>" +
                "<rect class='wf-line' x='24' y='52' width='72' height='6' rx='2'/>" +
                "<rect class='wf-line' x='24' y='64' width='52' height='6' rx='2'/>",
            "grid-2" =>
                "<rect class='wf-bar' x='8' y='8' width='104' height='10' rx='2'/>" +
                "<rect class='wf-card' x='8' y='26' width='48' height='50' rx='2'/>" +
                "<rect class='wf-card' x='64' y='26' width='48' height='50' rx='2'/>",
            "grid-3" =>
                "<rect class='wf-bar' x='8' y='8' width='104' height='10' rx='2'/>" +
                "<rect class='wf-card' x='8' y='26' width='30' height='50' rx='2'/>" +
                "<rect class='wf-card' x='45' y='26' width='30' height='50' rx='2'/>" +
                "<rect class='wf-card' x='82' y='26' width='30' height='50' rx='2'/>",
            "split" =>
                "<rect class='wf-bar' x='8' y='8' width='104' height='10' rx='2'/>" +
                "<rect class='wf-img' x='8' y='26' width='50' height='50' rx='2'/>" +
                "<rect class='wf-line' x='66' y='28' width='46' height='8' rx='2'/>" +
                "<rect class='wf-line' x='66' y='42' width='46' height='6' rx='2'/>" +
                "<rect class='wf-line' x='66' y='54' width='34' height='6' rx='2'/>" +
                "<rect class='wf-btn' x='66' y='66' width='30' height='10' rx='2'/>",
            "stack" =>
                "<rect class='wf-bar' x='8' y='8' width='104' height='10' rx='2'/>" +
                "<rect class='wf-img' x='8' y='26' width='104' height='30' rx='2'/>" +
                "<rect class='wf-line' x='8' y='60' width='104' height='6' rx='2'/>" +
                "<rect class='wf-line' x='8' y='70' width='70' height='6' rx='2'/>",
            "narrow" =>
                "<rect class='wf-bar' x='8' y='8' width='104' height='10' rx='2'/>" +
                "<rect class='wf-field' x='36' y='26' width='48' height='8' rx='2'/>" +
                "<rect class='wf-field' x='36' y='40' width='48' height='8' rx='2'/>" +
                "<rect class='wf-field' x='36' y='54' width='48' height='8' rx='2'/>" +
                "<rect class='wf-btn' x='36' y='68' width='48' height='8' rx='2'/>",
            "full" =>
                "<rect class='wf-bar' x='8' y='8' width='104' height='12' rx='2'/>" +
                "<rect class='wf-block' x='8' y='26' width='104' height='20' rx='2'/>" +
                "<rect class='wf-line' x='8' y='52' width='104' height='6' rx='2'/>" +
                "<rect class='wf-line' x='8' y='64' width='80' height='6' rx='2'/>",
            _ =>
                "<rect class='wf-bar' x='8' y='8' width='104' height='10' rx='2'/>" +
                "<rect class='wf-block' x='8' y='26' width='104' height='50' rx='2'/>",
        };
        return open + inner + close;
    }
}

<form asp-controller="CwThemeCore" asp-action="Configure" method="post">
    <div class="cards-group">
        @await Component.InvokeAsync("StoreScopeConfiguration")
        <div class="card card-default">
            <div class="card-header">
                @T("Plugins.CW.ThemeCore.Configure.BrandDesigner")
                <button type="submit" name="save" class="btn btn-primary float-right">
                    <i class="far fa-save"></i>
                    @T("Admin.Common.Save")
                </button>
            </div>
            <div class="card-body">
                <p class="text-muted">@T("Plugins.CW.ThemeCore.Configure.BrandDesigner.Hint")</p>

                <div class="row cw-designer-row">
                    <div class="col-lg-5 cw-controls-col">
                        <div class="form-group row">
                            <div class="col-md-12">
                                <div class="cw-brand-chips">
                                    @foreach (var preset in Model.BrandPresets)
                                    {
                                        <button type="button" class="btn btn-sm cw-brand-chip" data-prompt="@preset.Name"
                                                style="background-color: #@preset.PrimaryColor; border-color: #@preset.PrimaryColor;">@preset.Name</button>
                                    }
                                    <button type="button" id="cw-brand-surprise" class="btn btn-outline-primary btn-sm">🎲 Surprise me</button>
                                    <button type="button" id="cw-brand-reset" class="btn btn-outline-secondary btn-sm">Reset</button>
                                </div>
                            </div>
                        </div>
                        <p class="text-muted">@T("Plugins.CW.ThemeCore.Configure.AccentColours.Hint")</p>
                        <div id="cw-theme-settings">
                        <div class="form-group row">
                            <div class="col-md-6">
                                <nop-override-store-checkbox asp-for="DisableAccentColors_OverrideForStore" asp-input="DisableAccentColors" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="DisableAccentColors" />
                            </div>
                            <div class="col-md-6">
                                <nop-editor asp-for="DisableAccentColors" />
                                <span asp-validation-for="DisableAccentColors"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-6">
                                <nop-override-store-checkbox asp-for="PrimaryColor_OverrideForStore" asp-input="PrimaryColor" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="PrimaryColor" />
                            </div>
                            <div class="col-md-6">
                                <div class="input-group" style="max-width: 200px;">
                                    <input type="color" class="cw-color-picker form-control" style="max-width: 60px;" data-target="PrimaryColor" />
                                    <nop-editor asp-for="PrimaryColor" />
                                </div>
                                <span asp-validation-for="PrimaryColor"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-6">
                                <nop-override-store-checkbox asp-for="PrimaryTintColor_OverrideForStore" asp-input="PrimaryTintColor" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="PrimaryTintColor" />
                            </div>
                            <div class="col-md-6">
                                <div class="input-group" style="max-width: 200px;">
                                    <input type="color" class="cw-color-picker form-control" style="max-width: 60px;" data-target="PrimaryTintColor" />
                                    <nop-editor asp-for="PrimaryTintColor" />
                                </div>
                                <span asp-validation-for="PrimaryTintColor"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-6">
                                <nop-override-store-checkbox asp-for="SuccessColor_OverrideForStore" asp-input="SuccessColor" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="SuccessColor" />
                            </div>
                            <div class="col-md-6">
                                <div class="input-group" style="max-width: 200px;">
                                    <input type="color" class="cw-color-picker form-control" style="max-width: 60px;" data-target="SuccessColor" />
                                    <nop-editor asp-for="SuccessColor" />
                                </div>
                                <span asp-validation-for="SuccessColor"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-6">
                                <nop-override-store-checkbox asp-for="DangerColor_OverrideForStore" asp-input="DangerColor" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="DangerColor" />
                            </div>
                            <div class="col-md-6">
                                <div class="input-group" style="max-width: 200px;">
                                    <input type="color" class="cw-color-picker form-control" style="max-width: 60px;" data-target="DangerColor" />
                                    <nop-editor asp-for="DangerColor" />
                                </div>
                                <span asp-validation-for="DangerColor"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-6">
                                <nop-override-store-checkbox asp-for="WarningColor_OverrideForStore" asp-input="WarningColor" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="WarningColor" />
                            </div>
                            <div class="col-md-6">
                                <div class="input-group" style="max-width: 200px;">
                                    <input type="color" class="cw-color-picker form-control" style="max-width: 60px;" data-target="WarningColor" />
                                    <nop-editor asp-for="WarningColor" />
                                </div>
                                <span asp-validation-for="WarningColor"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-6">
                                <nop-override-store-checkbox asp-for="DarkColor_OverrideForStore" asp-input="DarkColor" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="DarkColor" />
                            </div>
                            <div class="col-md-6">
                                <div class="input-group" style="max-width: 200px;">
                                    <input type="color" class="cw-color-picker form-control" style="max-width: 60px;" data-target="DarkColor" />
                                    <nop-editor asp-for="DarkColor" />
                                </div>
                                <span asp-validation-for="DarkColor"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-6">
                                <nop-override-store-checkbox asp-for="ButtonRadius_OverrideForStore" asp-input="ButtonRadius" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="ButtonRadius" />
                            </div>
                            <div class="col-md-6">
                                <div class="cw-radius-row">
                                    <input type="range" id="ButtonRadius_range" min="0" max="24" step="1" />
                                    <nop-editor asp-for="ButtonRadius" />
                                </div>
                                <span asp-validation-for="ButtonRadius"></span>
                            </div>
                        </div>

                    @if (Model.LayoutSections.Any())
                    {
                        <p class="text-muted">@T("Plugins.CW.ThemeCore.Configure.Layouts.Hint")</p>
                        @for (var i = 0; i < Model.LayoutSections.Count; i++)
                        {
                            <input type="hidden" asp-for="LayoutSections[i].SectionKey" />
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-override-store-checkbox asp-for="LayoutSections[i].OverrideForStore" asp-input="LayoutSections[i].SelectedLayoutKey" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                    <label class="col-form-label">@Model.LayoutSections[i].Title</label>
                                </div>
                                <div class="col-md-9">
                                    @* Hidden native <select> stays the source of truth (model binding + the per-store
                                       override enable/disable target); the wireframe cards below are the visible UI. *@
                                    <select class="cw-layout-select cw-sr-only" data-cw-section="@Model.LayoutSections[i].SectionKey" asp-for="LayoutSections[i].SelectedLayoutKey">
                                        @foreach (var opt in Model.LayoutSections[i].Options)
                                        {
                                            <option value="@opt.Key">@opt.Title</option>
                                        }
                                    </select>
                                    <div class="cw-wf-cards" data-cw-section="@Model.LayoutSections[i].SectionKey">
                                        @foreach (var opt in Model.LayoutSections[i].Options)
                                        {
                                            <button type="button" class="cw-wf-card@(opt.Key == Model.LayoutSections[i].SelectedLayoutKey ? " active" : "")" data-cw-key="@opt.Key" title="@opt.Title" aria-label="@opt.Title">
                                                <span class="cw-wf-frame">@Html.Raw(LayoutWireframe(opt.Wireframe))</span>
                                                <span class="cw-wf-label">@opt.Title</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }

                </div>
                    <div class="form-group row">
                        <div class="col-md-12">
                            <label class="cw-ai-label">Ask the AI assistant</label>
                            <p class="cw-ai-hint text-muted">Describe the look you want and click Generate — it fills in the colours and settings for you. You can also ask it to tweak what you have now.</p>
                            <textarea id="cw-brand-prompt" class="form-control" rows="3" style="max-width: 1200px; resize: vertical;"
                                      placeholder="Describe the look, pick a vibe above, or ask for a tweak — e.g. “corporate blue with pill buttons”, “a more intense red”, “softer and warmer”, “square buttons”."></textarea>
                            <button type="button" id="cw-brand-generate" class="btn btn-primary mt-2">
                                <i class="fas fa-magic"></i> Generate
                            </button>
                            <small class="text-muted ml-2">Tip: press Ctrl+Enter to generate.</small>
                        </div>
                    </div>
                </div>
                    <div class="col-lg-7 cw-preview-col">
                        @if (Model.HasThemePreview)
                        {
                            <div class="cw-preview-toolbar">
                                <label class="cw-view-label" for="cw-view-select">Preview</label>
                                <select id="cw-view-select" class="form-control form-control-sm cw-view-select">
                                    @foreach (var pv in Model.PreviewViews)
                                    {
                                        <option value="@pv.Key">@pv.Title</option>
                                    }
                                </select>
                                <button type="button" id="cw-edit-toggle" class="btn btn-outline-secondary btn-sm" aria-pressed="false">
                                    <i class="fas fa-mouse-pointer"></i> Edit elements
                                </button>
                                <small class="text-muted cw-edit-hint" style="display: none;">Click a highlighted part of the preview to style it.</small>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.PreviewCss))
                            {
                                <style>@Html.Raw(Model.PreviewCss)</style>
                            }
                            <div id="cw-theme-preview" class="cw-store-preview">
                                @{ var cwFirstView = true; }
                                @foreach (var pv in Model.PreviewViews)
                                {
                                    <div class="cw-pv @(cwFirstView ? "active" : "")" data-view="@pv.Key">@Html.Raw(pv.Html)</div>
                                    cwFirstView = false;
                                }
                            </div>
                            @if (Model.LivePreviewEnabled)
                            {
                                <div id="cw-live-stage" class="cw-live-stage" style="display: none;">
                                    <iframe id="cw-live-frame" class="cw-live-frame" title="Live storefront preview"></iframe>
                                </div>
                                <div id="cw-live-fallback" class="cw-live-fallback" style="display: none;">Couldn't load the live preview — showing a representative mock.</div>
                            }
                        }
                        else
                        {
                            <div class="cw-preview-toolbar">
                                <label class="cw-view-label">Preview</label>
                                <span class="cw-preview-generic-note">
                                    Element editing is available for CW themes. The active theme
                                    <strong>@(string.IsNullOrWhiteSpace(Model.PreviewThemeName) ? "(none)" : Model.PreviewThemeName)</strong>
                                    isn't a CW theme — showing a generic preview. Colour dials apply only to themes that use the CW tokens; Custom CSS still applies.
                                </span>
                            </div>
                            <div id="cw-theme-preview" class="cw-store-preview cw-generic-preview">
                                <div class="cw-gp-header"><span class="cw-gp-logo">STORE</span><span class="cw-gp-search"></span></div>
                                <div class="cw-gp-grid"><div class="cw-gp-card"></div><div class="cw-gp-card"></div><div class="cw-gp-card"></div></div>
                                <div class="cw-gp-footer"></div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        
        <div class="card card-default">
            <div class="card-header">
                @T("Plugins.CW.ThemeCore.Configure.CustomCss")
            </div>
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="CustomCssUrlPolicy_OverrideForStore" asp-input="CustomCssUrlPolicy" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="CustomCssUrlPolicy" />
                    </div>
                    <div class="col-md-9">
                        <nop-select asp-for="CustomCssUrlPolicy" asp-items="@Html.GetEnumSelectList<CustomCssUrlPolicy>()" />
                        <span asp-validation-for="CustomCssUrlPolicy"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="CustomCss_OverrideForStore" asp-input="CustomCss" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="CustomCss" />
                    </div>
                    <div class="col-md-9">
                        <nop-textarea asp-for="CustomCss" style="height: 320px; font-family: monospace;" />
                        <span asp-validation-for="CustomCss"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="card card-default">
            <div class="card-header">
                @T("Plugins.CW.ThemeCore.Configure.Title")
            </div>
            <div class="card-body">

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="LogoPictureId_OverrideForStore" asp-input="LogoPictureId" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="LogoPictureId" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="LogoPictureId" />
                        <span asp-validation-for="LogoPictureId"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="SecondLogoPictureId_OverrideForStore" asp-input="SecondLogoPictureId" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="SecondLogoPictureId" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="SecondLogoPictureId" />
                        <span asp-validation-for="SecondLogoPictureId"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="SecondLogoLinkUrl_OverrideForStore" asp-input="SecondLogoLinkUrl" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="SecondLogoLinkUrl" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="SecondLogoLinkUrl" />
                        <span asp-validation-for="SecondLogoLinkUrl"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="ReverseLogos_OverrideForStore" asp-input="ReverseLogos" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="ReverseLogos" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ReverseLogos" />
                        <span asp-validation-for="ReverseLogos"></span>
                    </div>
                </div>


        </div>
    </div>

    </div>
</form>

<style>
    .cw-brand-chips { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    /* vibe chips are filled with each preset's own primary colour (inline bg) so the user sees the style at a glance */
    .cw-brand-chip { color: #fff; font-weight: 600; }
    .cw-brand-chip:hover, .cw-brand-chip:focus { color: #fff; filter: brightness(1.08); }
    .cw-brand-swatches { display: flex; flex-wrap: wrap; gap: 14px; }
    .cw-brand-swatches .cw-sw { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #6b7280; }
    .cw-brand-swatches .cw-sw-dot { width: 22px; height: 22px; border-radius: 6px; border: 1px solid rgba(0,0,0,.12); background: #ccc; }
    /* two-column designer row: brand/layout controls LEFT, preview RIGHT (wide, sticky, tall); stacks below lg.
       Source order is controls-then-preview, which is also the visual order, so no flex reordering is needed. */
    /* button-radius row: slider + number box, vertically centred (Bootstrap .input-group doesn't align a range input) */
    .cw-radius-row { display: flex; align-items: center; gap: 12px; max-width: 200px; }
    .cw-radius-row input[type="range"] { flex: 1 1 auto; min-width: 0; padding: 0; margin: 0; }
    .cw-radius-row .form-control { flex: 0 0 72px; width: 72px; }
    .cw-ai-label { display: block; font-weight: 600; margin-bottom: 2px; color: #22262e; }
    .cw-ai-hint { margin-bottom: 8px; font-size: 13px; }
    .cw-designer-row { margin-top: 18px; }
    /* keep the intro paragraph clean: no rule after it (designer-row border removed) and none before it
       (hide the brand-designer card's header separator only — scoped so other cards keep theirs) */
    .card:has(.cw-designer-row) > .card-header { border-bottom: 0; }
    .cw-designer-row .cw-controls-col { margin-bottom: 16px; }
    @@media (min-width: 992px) {
        .cw-designer-row .cw-controls-col { margin-bottom: 0; }
        .cw-designer-row .cw-preview-col { position: sticky; top: 12px; align-self: flex-start; }
    }
    /* mini-storefront live preview — recolours from the --cw-* vars the preview JS sets on #cw-theme-preview */
    .cw-store-preview { border: 1px solid #e6e8ec; border-radius: 10px; overflow: hidden; background: #fff;
        font-family: "Segoe UI", Roboto, Arial, sans-serif; color: #22262e; max-width: 100%; }
    /* live preview (Phase 1): the iframe renders the storefront at a DESKTOP width (set in JS) and is scaled
       down to fit the column, so the theme's desktop breakpoints apply — a column-width iframe would otherwise
       trigger the tablet/phone layout. The stage clips to the scaled size; its height is set in JS. */
    .cw-live-stage { position: relative; width: 100%; overflow: hidden; border: 1px solid #e6e8ec; border-radius: 10px; background: #fff; }
    .cw-live-frame { display: block; border: 0; background: #fff; transform-origin: 0 0; }
    .cw-live-fallback { max-width: 100%; margin-top: 10px; font-size: 12px; color: #a4661a; }

    /* wireframe layout pickers (replace the plain <select>; the real <select> stays sr-only for binding) */
    .cw-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
    .cw-wf-cards { display: flex; flex-wrap: wrap; gap: 12px; }
    .cw-wf-cards.cw-disabled { opacity: .5; pointer-events: none; }
    .cw-wf-card { display: flex; flex-direction: column; gap: 6px; width: 130px; padding: 8px; background: #fff; border: 2px solid #e6e8ec; border-radius: 10px; cursor: pointer; text-align: center; transition: border-color .12s, box-shadow .12s; }
    .cw-wf-card:hover { border-color: #c3c9d2; }
    .cw-wf-card.active { border-color: #2f6fed; box-shadow: 0 0 0 3px rgba(47,111,237,.12); }
    .cw-wf-frame { display: block; }
    .cw-wf-svg { width: 100%; height: auto; display: block; }
    .cw-wf-svg .wf-page { fill: #fff; stroke: #d9dde3; stroke-width: 1.5; }
    .cw-wf-svg .wf-bar { fill: #b7c0cc; }
    .cw-wf-svg .wf-block, .cw-wf-svg .wf-card, .cw-wf-svg .wf-img { fill: #eef0f3; stroke: #e2e6ec; stroke-width: 1; }
    .cw-wf-svg .wf-img { fill: #e2e6ec; }
    .cw-wf-svg .wf-line { fill: #d7dbe1; }
    .cw-wf-svg .wf-field { fill: #eef0f3; stroke: #dfe3e8; stroke-width: 1; }
    .cw-wf-svg .wf-btn { fill: #9aa4b2; }
