            setPreviewLogo(preview.querySelector('[data-cw-logo="primary"]'), previewReverseLogos ? previewSecondLogo : previewPrimaryLogo);
            setPreviewLogo(preview.querySelector('[data-cw-logo="second"]'), previewReverseLogos ? previewPrimaryLogo : previewSecondLogo);
        }
