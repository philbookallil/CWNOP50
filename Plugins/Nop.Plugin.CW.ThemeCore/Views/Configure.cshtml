            radiusInput.addEventListener('input', refresh);
            radiusInput.addEventListener('change', refresh);
        }

        // ---- Point-and-click element editor (scoped to the preview sandbox) ----
        // Each styleable preview element carries data-cw-style="<region>"; clicking it (in Edit mode) opens an
        // inline popover whose controls write to the SAME curated fields/tokens — never an arbitrary selector.
        var editToggle = document.getElementById('cw-edit-toggle');
        var editHint = document.querySelector('.cw-edit-hint');
        var popover = null;
        var selectedEl = null;
        var selectedRect = null; // when the selection is inside the live iframe: its target rect in admin viewport coords
        var popoverSync = []; // callbacks that re-read the fields into the open popover's controls after an AI tweak

        var regionConfig = {
            header:  { label: 'Header',             controls: [{ kind: 'color', target: 'PrimaryColor', label: 'Colour' }] },
            nav:     { label: 'Navigation',         controls: [{ kind: 'color', target: 'PrimaryColor', label: 'Colour' }] },
            link:    { label: 'Links',              controls: [{ kind: 'color', target: 'PrimaryColor', label: 'Colour' }] },
            button:  { label: 'Buttons',            controls: [{ kind: 'color', target: 'PrimaryColor', label: 'Colour' }, { kind: 'radius', label: 'Corners' }] },
            tint:    { label: 'Tinted areas',       controls: [{ kind: 'color', target: 'PrimaryTintColor', label: 'Background' }] },
            hero:    { label: 'Tinted areas',       controls: [{ kind: 'color', target: 'PrimaryTintColor', label: 'Background' }] },
            danger:  { label: 'Sale / danger',      controls: [{ kind: 'color', target: 'DangerColor', label: 'Colour' }] },
            success: { label: 'In-stock / success', controls: [{ kind: 'color', target: 'SuccessColor', label: 'Colour' }] },
            warning: { label: 'Ratings / warning',  controls: [{ kind: 'color', target: 'WarningColor', label: 'Colour' }] },
            dark:    { label: 'Footer / dark',      controls: [{ kind: 'color', target: 'DarkColor', label: 'Colour' }] }
