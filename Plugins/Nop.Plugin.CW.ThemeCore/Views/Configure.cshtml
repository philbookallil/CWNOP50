        function buildColorRow(cfg) {
            var field = document.getElementById(cfg.target);
            var cur = normalize(field ? field.value : '');
            var row = document.createElement('div'); row.className = 'cw-pop-row';
            var lab = document.createElement('label'); lab.textContent = cfg.label; row.appendChild(lab);
            var color = document.createElement('input'); color.type = 'color';
            if (/^[0-9a-fA-F]{6}$/.test(cur)) color.value = '#' + cur;
            var text = document.createElement('input'); text.type = 'text'; text.className = 'form-control form-control-sm'; text.value = cur;
            function apply(v) {
                var nv = normalize(v);
                if (field) field.value = nv;
                var picker = document.querySelector('.cw-color-picker[data-target="' + cfg.target + '"]');
                if (/^[0-9a-fA-F]{6}$/.test(nv)) { if (picker) picker.value = '#' + nv; color.value = '#' + nv; }
