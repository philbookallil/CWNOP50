                complete: done
            });
        }

        function buildTokens() {
            var t = {};
            Object.keys(map).forEach(function (id) {
                var el = document.getElementById(id); if (!el) return;
                var v = normalize(el.value); if (hexRe.test(v)) t[map[id]] = '#' + v;
            });
            t['--cw-btn-radius'] = currentRadius() + 'px';
            return t;
        }
        function buildLayout(name) {
            var section = viewToSection[name];
            var classes = section && layoutClassMap ? layoutClassMap[section] : null;
            if (!classes) return { allClasses: [], selected: '' };
            var all = Object.keys(classes).map(function (k) { return classes[k]; }).filter(function (c) { return !!c; });
            var sel = document.querySelector('.cw-layout-select[data-cw-section="' + section + '"]');
            var key = sel ? sel.value : null;
            return { allClasses: all, selected: (key != null && classes[key] != null) ? classes[key] : '' };
        }
        function postDraftToFrame() {
            if (!liveReady || !liveFrame || !liveFrame.contentWindow || !storeOrigin) return;
            var name = viewSelect ? viewSelect.value : 'home';
            try { liveFrame.contentWindow.postMessage({ type: 'cw-preview:apply', tokens: buildTokens(), layout: buildLayout(name) }, storeOrigin); } catch (e) { }
        }
        function editModeOn() { return editToggle && editToggle.classList.contains('active'); }
        function sendEditMode(on) {
            if (!liveReady || !liveFrame || !liveFrame.contentWindow || !storeOrigin) return;
            try { liveFrame.contentWindow.postMessage({ type: on ? 'cw-preview:edit-on' : 'cw-preview:edit-off' }, storeOrigin); } catch (e) { }
        }
        // a rect from the framed page (frame-viewport coords) → admin viewport coords, undoing the iframe's scale + offset
        function transformFrameRect(fr) {
            if (!fr) return null;
            var stage = liveStage ? liveStage.getBoundingClientRect() : { left: 0, top: 0 };
            var scale = (liveStage && liveStage.clientWidth) ? (liveStage.clientWidth / CW_DESKTOP_W) : 1;
            var left = stage.left + fr.x * scale, top = stage.top + fr.y * scale;
            var w = fr.width * scale, h = fr.height * scale;
            return { left: left, top: top, right: left + w, bottom: top + h, width: w, height: h };
        }
        window.addEventListener('message', function (e) {
            if (!storeOrigin || e.origin !== storeOrigin || !e.data) return;
            if (e.data.type === 'cw-preview:ready') {
                liveReady = true;
                if (liveTimer) { clearTimeout(liveTimer); liveTimer = null; }
                if (liveFallback) liveFallback.style.display = 'none';
                postDraftToFrame();
                if (editModeOn()) sendEditMode(true); // re-arm edit mode after a (re)load
            } else if (e.data.type === 'cw-preview:selected') {
                if (!regionConfig[e.data.region]) return;
                openPopoverForRegion(e.data.region, transformFrameRect(e.data.rect));
            }
        });

        function showView(name) {
            views.forEach(function (v) { v.classList.toggle('active', v.getAttribute('data-view') === name); });
            closePopover(); // selection may live in a now-hidden view
        }

        function selectView(name) {
            closePopover(); // a selection may belong to the view we're leaving
            var url = liveUrlFor(name);
            if (url) {
                if (preview) preview.style.display = 'none';
                if (liveStage) liveStage.style.display = '';
                scaleLiveFrame();
                if (liveLoadedView !== name) {
                    liveReady = false; liveLoadedView = name;
                    if (liveFallback) liveFallback.style.display = 'none';
                    if (liveTimer) { clearTimeout(liveTimer); liveTimer = null; }
                    withFreshPreviewToken(function () {
                        if (liveLoadedView !== name) return; // the admin moved on while the token was refreshing
                        liveFrame.src = withPreviewToken(url);
                        liveTimer = setTimeout(function () {
                            if (!liveReady) { // couldn't load / no bridge → fall back to the mock
                                if (liveStage) liveStage.style.display = 'none';
                                if (preview) preview.style.display = '';
                                showView(name);
                                if (liveFallback) liveFallback.style.display = '';
                            }
                        }, 6000);
                    });
                } else {
                    postDraftToFrame();
                }
            } else { // no live URL for this view (e.g. a store without categories), or live disabled → the mock
                if (liveStage) liveStage.style.display = 'none';
                if (liveFallback) liveFallback.style.display = 'none';
                if (preview) preview.style.display = '';
                showView(name);
            }
        }

        if (viewSelect) {
            selectView(viewSelect.value);
            viewSelect.addEventListener('change', function () { selectView(viewSelect.value); });
        } else if (views.length) {
            views[0].classList.add('active');
        }

        // wireframe layout pickers: the cards write to the (hidden) <select>, which stays the source of truth for
        // model binding + the per-store override enable/disable; the select's change then drives the live preview.
        function syncLayoutCards(sel) {
            var wrap = document.querySelector('.cw-wf-cards[data-cw-section="' + sel.getAttribute('data-cw-section') + '"]');
            if (!wrap) return;
            wrap.classList.toggle('cw-disabled', sel.disabled);
            wrap.querySelectorAll('.cw-wf-card').forEach(function (c) {
                c.classList.toggle('active', c.getAttribute('data-cw-key') === sel.value);
            });
        }
        document.querySelectorAll('.cw-layout-select').forEach(function (sel) {
            sel.addEventListener('change', function () { postDraftToFrame(); syncLayoutCards(sel); });
            // the override checkbox toggles the select's disabled attr → mirror that onto the cards
            new MutationObserver(function () { syncLayoutCards(sel); }).observe(sel, { attributes: true, attributeFilter: ['disabled'] });
            syncLayoutCards(sel);
        });
        document.querySelectorAll('.cw-wf-card').forEach(function (card) {
            card.addEventListener('click', function () {
                var wrap = card.closest('.cw-wf-cards');
                var sel = wrap && document.querySelector('.cw-layout-select[data-cw-section="' + wrap.getAttribute('data-cw-section') + '"]');
                if (!sel || sel.disabled || sel.value === card.getAttribute('data-cw-key')) return;
                sel.value = card.getAttribute('data-cw-key');
                sel.dispatchEvent(new Event('change', { bubbles: true }));
            });
        });

        applyPreviewLogos();
        refresh();
    });
</script>
