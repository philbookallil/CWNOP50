            var input = document.createElement('input'); input.type = 'text'; input.className = 'form-control form-control-sm';
            input.placeholder = 'Tweak with AI…';
            var btn = document.createElement('button'); btn.type = 'button'; btn.className = 'btn btn-primary btn-sm'; btn.title = 'Apply tweak';
            btn.innerHTML = '<i class="fas fa-magic"></i>';
