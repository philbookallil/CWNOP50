@model Nop.Plugin.CW.Freight.Models.ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
    NopHtml.SetActiveMenuItemSystemName("Shipping providers");
}

<div class="row pb-3">
    <div class="col-md-12">
        <div class="float-right">
            <a asp-controller="CWFreight" asp-action="CreateFreightMethod" class="btn btn-primary">
                <i class="fas fa-plus-square"></i>
                @T("Admin.Common.AddNew")
            </a>
        </div>
    </div>
</div>

<form asp-controller="CWFreight" asp-action="Configure" method="post" id="cw-freight-configure-form">
    <div class="cards-group">

        @* Search panel *@
        <div class="card card-default card-search">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group row">
                            <div class="col-md-4">
                                <nop-label asp-for="SearchStoreId" />
                            </div>
                            <div class="col-md-8">
                                <nop-select asp-for="SearchStoreId" asp-items="Model.AvailableStores" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <button type="button" id="search-methods" class="btn btn-primary btn-search">
                            <i class="fas fa-search"></i>
                            @T("Admin.Common.Search")
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @* Methods grid *@
        <div class="card card-default">
            <div class="card-body">
                @await Html.PartialAsync("~/Plugins/CW.Freight/Views/_ShippingMethodGrid.cshtml", Model)
            </div>
        </div>

        @* Settings panel *@
        <div class="card card-default">
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="LimitMethodsToCreated" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="LimitMethodsToCreated" />
                        <span asp-validation-for="LimitMethodsToCreated"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="submit" name="save" class="btn btn-primary">
                            <i class="far fa-save"></i>
                            @T("Admin.Common.Save")
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</form>
